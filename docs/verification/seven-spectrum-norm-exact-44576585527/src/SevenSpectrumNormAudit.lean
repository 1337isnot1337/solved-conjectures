29", "Conjectures.LonelinessFourSpeedLift31", "Conjectures.LonelinessFourSpeedLift37", "Conjectures.LonelinessFourSpeedLift41", "Conjectures.LonelinessFourSpeedLift43", "Conjectures.LonelinessFourSpeedLift47", "Conjectures.LonelinessFourSpeedLift53", "Conjectures.LonelinessFourSpeedLift59", "Conjectures.LonelinessFourSpeedLift61", "Conjectures.LonelinessFourSpeedLiftDirections", "Conjectures.LonelinessFourSpeedLiftSound", "Conjectures.LonelinessHyperplaneArithmetic", "Conjectures.LonelinessIntegerDirection", "Conjectures.LonelinessKZBasisGram", "Conjectures.LonelinessKZBasisInteger", "Conjectures.LonelinessKZBasisOperations", "Conjectures.LonelinessKZBasisReduction", "Conjectures.LonelinessKZBasisStep", "Conjectures.LonelinessKZBasisVectors", "Conjectures.LonelinessKZGeneral", "Conjectures.LonelinessKZProductAssembly", "Conjectures.LonelinessKZProductCertificate", "Conjectures.LonelinessKZProductOrder", "Conjectures.LonelinessKZSmallData", "Conjectures.LonelinessMax", "Conjectures.LonelinessModularDirections", "Conjectures.LonelinessModularFoldedSearch", "Conjectures.LonelinessModularForcedDivisor", "Conjectures.LonelinessModularLift", "Conjectures.LonelinessModularNormalize", "Conjectures.LonelinessModularPrimes", "Conjectures.LonelinessModularRationalWitness", "Conjectures.LonelinessModularSearch", "Conjectures.LonelinessModularShortVector", "Conjectures.LonelinessModularWitness", "Conjectures.LonelinessNearestPlane", "Conjectures.LonelinessNearestPlanePrefix", "Conjectures.LonelinessNearestPlaneRelative", "Conjectures.LonelinessNearestPlaneValue", "Conjectures.LonelinessNormGeometry", "Conjectures.LonelinessNormalization", "Conjectures.LonelinessPacking", "Conjectures.LonelinessPackingLower", "Conjectures.LonelinessPairBridge", "Conjectures.LonelinessPigeonhole", "Conjectures.LonelinessPigeonholePlane", "Conjectures.LonelinessPlaneDirections", "Conjectures.LonelinessPlaneGap", "Conjectures.LonelinessPrefixProduct", "Conjectures.LonelinessPrefixProductTables", "Conjectures.LonelinessPrimitiveBasis", "Conjectures.LonelinessPrimitiveSpeeds", "Conjectures.LonelinessProductFamily", "Conjectures.LonelinessRational", "Conjectures.LonelinessRationalSubspace", "Conjectures.LonelinessRenaultAffine", "Conjectures.LonelinessRenaultAssembly", "Conjectures.LonelinessRenaultFiveSpeed", "Conjectures.LonelinessRenaultGcdOrbit", "Conjectures.LonelinessRenaultMaximizer", "Conjectures.LonelinessRenaultNormalization", "Conjectures.LonelinessRenaultOrdering", "Conjectures.LonelinessRenaultParityCases", "Conjectures.LonelinessRenaultPhaseCells", "Conjectures.LonelinessRenaultPhaseCertificates", "Conjectures.LonelinessRenaultPreliminaries", "Conjectures.LonelinessRenaultRationalOrbit", "Conjectures.LonelinessRenaultReindex", "Conjectures.LonelinessRenaultSmallPhases", "Conjectures.LonelinessRenaultThirdObstructions", "Conjectures.LonelinessRenaultThreeEven", "Conjectures.LonelinessRenaultTwoMultiples", "Conjectures.LonelinessRenaultTwoMultiplesCase", "Conjectures.LonelinessRenaultTwoMultiplesFinal", "Conjectures.LonelinessRenaultTwoMultiplesPhase", "Conjectures.LonelinessSevenSpectrumNormGeometry", "Conjectures.LonelinessSmallRunner", "Conjectures.LonelinessSubspaceDensity", "Conjectures.LonelinessSubspaceExtension", "Conjectures.LonelinessTwoDirections", "Conjectures.NonmixedGapDensity", "Conjectures.NonmixedGapPeriodic", "Conjectures.NonmixedGapResidues"]
  let required : Array Name := #[`Loneliness.SevenSpectrumNormGeometry.exists_gram_data, `Loneliness.SevenSpectrumNormGeometry.increment_product, `Loneliness.SevenSpectrumNormGeometry.numerical_margin, `Loneliness.SevenSpectrumNormGeometry.squaredNorm_mul_le, `Loneliness.SevenSpectrumNormGeometry.natural_squaredNorm_le, `Loneliness.SevenSpectrumNormGeometry.squaredNorm_lt, `Loneliness.SevenSpectrumNormGeometry.norm_lt, `Loneliness.SevenSpectrumNormGeometry.natural_squaredNorm_lt, `Loneliness.SevenSpectrumNormGeometry.all_primes, `Loneliness.SevenSpectrumNormGeometry.prime_product, `Loneliness.SevenSpectrumNormGeometry.prime_product_margin, `Loneliness.SevenSpectrumNormGeometry.exists_prime_avoiding, `Loneliness.SevenSpectrumNormGeometry.primeSet16_subset, `Loneliness.SevenSpectrumNormGeometry.primeSet16_card, `Loneliness.SevenSpectrumNormGeometry.all_primes16, `Loneliness.SevenSpectrumNormGeometry.prime_product16, `Loneliness.SevenSpectrumNormGeometry.prime_product_margin16, `Loneliness.SevenSpectrumNormGeometry.exists_prime_avoiding16, `Loneliness.SevenSpectrumNormGeometry.forced_divisor_seven, `Loneliness.SevenSpectrumNormGeometry.forced_divisor_of_strict, `Loneliness.SevenSpectrumNormGeometry.primeSet15_subset, `Loneliness.SevenSpectrumNormGeometry.primeSet15_card, `Loneliness.SevenSpectrumNormGeometry.all_primes15, `Loneliness.SevenSpectrumNormGeometry.prime_product15, `Loneliness.SevenSpectrumNormGeometry.prime_product_coprime15, `Loneliness.SevenSpectrumNormGeometry.prime_product_margin15, `Loneliness.SevenSpectrumNormGeometry.exists_prime_avoiding15]
  let legacyPrefixes : Array String := #["Loneliness."]
  let allowed : Array Name := #[`propext, `Classical.choice, `Quot.sound]
  let env ← getEnv
  if env.header.isModule then
    throwError "All-owned audit must use legacy private-import mode"
  unless env.header.modules.size == env.header.moduleData.size do
    throwError "Imported module/data inventory size mismatch"
  let mut rawNames : NameSet := {}
  let mut seenModules : Array String := #[]
  for h : idx in [0:env.header.modules.size] do
    let mod := env.header.modules[idx]
    let moduleName := mod.module.toString
    let isProject := moduleName == "Solitaire" || moduleName.startsWith "Solitaire." ||
      moduleName == "Conjectures" || moduleName.startsWith "Conjectures."
    unless !isProject || expectedModules.contains moduleName do
      throwError "Unregistered project module in audit: {moduleName}"
    if expectedModules.contains moduleName then
      unless mod.hasData && mod.importAll do
        throwError "Project module lacks complete private data: {moduleName}"
      let data := env.header.moduleData[idx]!
      unless data.constNames == data.constants.map (·.name) do
        throwError "Serialized declaration names differ from their constants: {moduleName}"
      seenModules := seenModules.push moduleName
      let mut privateCount := 0
      for name in data.constNames do
        unless (env.find? name).isSome do
          throwError "Serialized project declaration is invisible: {moduleName}: {name}"
        rawNames := rawNames.insert name
        if (privateToUserName? name).isSome then
          privateCount := privateCount + 1
      let record := Json.mkObj [
        ("tag", toJson "module"), ("module", toJson moduleName),
        ("modern", toJson data.isModule), ("import_all", toJson mod.importAll),
        ("has_data", toJson mod.hasData),
        ("names", toJson (data.constNames.map (·.toString))),
        ("private_count", toJson privateCount)]
      logInfo m!"ALL-OWNED-JSON {record.compress}"
  unless seenModules.size == expectedModules.size &&
      expectedModules.all seenModules.contains do
    throwError "Incomplete exact project module inventory"
  let mut audited : NameSet := {}
  let mut declarations := 0
  let mut theorems := 0
  let mut privateDeclarations := 0
  for (name, info) in env.constants.toList do
    let owner := match env.getModuleIdxFor? name |>.bind (env.header.modules[·]?) with
      | some mod => mod.module.toString
      | none => ""
    let userName := privateToUserName name
    let byModule := expectedModules.contains owner
    let bySerialized := rawNames.contains name
    let byLegacy := legacyPrefixes.any (fun p => userName.toString.startsWith p)
    if byModule || bySerialized || byLegacy then
      declarations := declarations + 1
      audited := audited.insert name
      let kind := match info with
        | .axiomInfo _ => "axiom"
        | .defnInfo _ => "definition"
        | .thmInfo _ => "theorem"
        | .opaqueInfo _ => "opaque"
        | .quotInfo _ => "quotient"
        | .ctorInfo _ => "constructor"
        | .recInfo _ => "recursor"
        | .inductInfo _ => "inductive"
      if info.isTheorem then
        theorems := theorems + 1
      let privateName := privateToUserName? name
      if privateName.isSome then
        privateDeclarations := privateDeclarations + 1
      if let .axiomInfo _ := info then
        unless allowed.contains name do
          throwError "Unapproved project axiom {name}"
      let axioms ← collectAxioms name
      for axiomName in axioms do
        unless allowed.contains axiomName do
          throwError "Unapproved axiom {axiomName} in {name}"
      let record := Json.mkObj [
        ("tag", toJson "declaration"), ("name", toJson name.toString),
        ("owner", toJson owner), ("kind", toJson kind),
        ("private_user_name", toJson (privateName.map (·.toString))),
        ("by_module", toJson byModule), ("by_serialized", toJson bySerialized),
        ("by_legacy_prefix", toJson byLegacy),
        ("axioms", toJson (axioms.map (·.toString)))]
      logInfo m!"ALL-OWNED-JSON {record.compress}"
  for name in rawNames.toArray do
    unless audited.contains name do
      throwError "Serialized project declaration escaped the audit: {name}"
  for name in required do
    let _ ← getConstInfo name
    unless audited.contains name do
      throwError "Required declaration is outside audited ownership: {name}"
    let record := Json.mkObj [("tag", toJson "required"), ("name", toJson name.toString)]
    logInfo m!"ALL-OWNED-JSON {record.compress}"
  let record := Json.mkObj [
    ("tag", toJson "passed"), ("modules", toJson seenModules.size),
    ("declarations", toJson declarations), ("theorems", toJson theorems),
    ("private_declarations", toJson privateDeclarations),
    ("raw_declarations", toJson rawNames.toArray.size),
    ("required", toJson required.size), ("allowed_axioms", toJson (allowed.map (·.toString)))]
  logInfo m!"ALL-OWNED-JSON {record.compress}"
