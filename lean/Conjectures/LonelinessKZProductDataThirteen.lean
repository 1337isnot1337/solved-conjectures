import Conjectures.LonelinessKZProductDataThirteenBlock00
import Conjectures.LonelinessKZProductDataThirteenBlock01
import Conjectures.LonelinessKZProductDataThirteenBlock02
import Conjectures.LonelinessKZProductDataThirteenBlock03
import Conjectures.LonelinessKZProductDataThirteenBlock04
import Conjectures.LonelinessKZProductDataThirteenBlock05
import Conjectures.LonelinessKZProductDataThirteenBlock06
import Conjectures.LonelinessKZProductDataThirteenBlock07
import Conjectures.LonelinessKZProductDataThirteenBlock08
import Conjectures.LonelinessKZProductDataThirteenBlock09
import Conjectures.LonelinessKZProductDataThirteenBlock10
import Conjectures.LonelinessKZProductDataThirteenBlock11
import Conjectures.LonelinessKZProductDataThirteenBlock12
import Conjectures.LonelinessKZProductDataThirteenBlock13
import Conjectures.LonelinessKZProductDataThirteenBlock14
import Conjectures.LonelinessKZProductDataThirteenBlock15

/-! All 4096 twelve-dimensional subset certificates, assembled from
sixteen independently checked blocks. No real variables are sampled.
Generated by scripts/generate_loneliness_kz_certificates.py. -/

namespace Loneliness.KZProduct.Thirteen

set_option maxRecDepth 100000
set_option maxHeartbeats 0

noncomputable def blockCertificate (b : Fin 16) (m : Fin 256) : FastRow :=
  match b.val with
  | 0 => Block00.certificate m
  | 1 => Block01.certificate m
  | 2 => Block02.certificate m
  | 3 => Block03.certificate m
  | 4 => Block04.certificate m
  | 5 => Block05.certificate m
  | 6 => Block06.certificate m
  | 7 => Block07.certificate m
  | 8 => Block08.certificate m
  | 9 => Block09.certificate m
  | 10 => Block10.certificate m
  | 11 => Block11.certificate m
  | 12 => Block12.certificate m
  | 13 => Block13.certificate m
  | 14 => Block14.certificate m
  | 15 => Block15.certificate m
  | _ => default

private theorem block_valid (b : Fin 16) (m : Fin 256) :
    FastValid 12 bounds (fun i => (b.val*256+m.val).testBit i.val)
      (blockCertificate b m) := by
  fin_cases b
  · simpa only [blockCertificate, Fin.val_mk] using
      Block00.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block01.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block02.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block03.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block04.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block05.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block06.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block07.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block08.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block09.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block10.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block11.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block12.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block13.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block14.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block15.rows_valid m

noncomputable def certificate (m : Fin (2^12)) : FastRow :=
  assembleCertificate blockCertificate m

noncomputable def row (m : Fin (2^12)) : DualRow := (certificate m).dual

theorem rows_valid (m : Fin (2^12)) :
    DualValid 12 bounds (fun i => m.val.testBit i.val) (row m) := by
  apply fast_valid_correct bounds (fun i => m.val.testBit i.val) (certificate m)
  exact assemble_valid blockCertificate block_valid m

end Loneliness.KZProduct.Thirteen
