def orbitCertificate (i : Index) : Finset (List ℕ) :=
  (orbitListCertificate i).toFinset

theorem orbitListCertificate_nodup (i : Index) : (orbitListCertificate i).Nodup := by
  fin_cases i <;> decide +kernel

theorem orbitSix_certificate (i : Index) : orbitSix i = orbitCertificate i := by
  trans ((parts i) ++ List.replicate (6-(parts i).length) 0).permutations'.toFinset
  · ext e
    simp only [orbitSix, List.mem_toFinset, List.mem_permutations, List.mem_permutations']
  · fin_cases i <;> decide +kernel

/-- A literal monomial, with six variables in their fixed order. -/
noncomputable def termSix (e : List ℕ) (x : Fin 6 → ℝ) : ℝ :=
  x 0 ^ e[0]! * x 1 ^ e[1]! * x 2 ^ e[2]! *
  x 3 ^ e[3]! * x 4 ^ e[4]! * x 5 ^ e[5]!

/-- The monomial symmetric polynomial, summing distinct exponent permutations. -/
noncomputable def monomialSix (i : Index) (x : Fin 6 → ℝ) : ℝ :=
  ∑ e ∈ orbitSix i, termSix e x

/-- The product of power sums indexed by a partition. -/
noncomputable def powerSix (i : Index) (x : Fin 6 → ℝ) : ℝ :=
  ((parts i).map (fun a => ∑ k : Fin 6, x k ^ a)).prod

/-- The literal finite orbit sum can be evaluated as a duplicate-free list sum.
The orbit and its lack of duplicates are proved once, independently of x. -/
theorem monomialSix_eq_list (i : Index) (x : Fin 6 → ℝ) :
    monomialSix i x = ((orbitListCertificate i).map (fun e => termSix e x)).sum := by
  unfold monomialSix
  rw [orbitSix_certificate]
  exact List.sum_toFinset (fun e => termSix e x) (orbitListCertificate_nodup i)

/- Materialize the defining equations in their owning module.
Sibling modules must import these checked equations, rather than create them independently. -/
open Lean Elab Command in
run_cmd do
  liftTermElabM do
    for name in #[
      ``ChenKhareSahi.Orthogonality.orbitSix,
      ``ChenKhareSahi.Orthogonality.orbitListCertificate,
      ``ChenKhareSahi.Orthogonality.orbitCertificate,
      ``ChenKhareSahi.Orthogonality.termSix,
      ``ChenKhareSahi.Orthogonality.monomialSix,
      ``ChenKhareSahi.Orthogonality.powerSix] do
      discard <| Lean.Meta.getEqnsFor? name

end ChenKhareSahi.Orthogonality
