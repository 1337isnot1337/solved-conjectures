def inverse (a : ℕ) : ℕ := if a < 76 then inverseData.get a else 0

theorem inverse_checked : ∀ a : Fin 76, 0 < a.val →
    (a.val * inverse a.val) % 151 = 1 := by
  decide +kernel

theorem inverse_valid (a : ℕ) (ha : 0 < a) (hbound : 2 * a ≤ 151) :
    (a * inverse a) % 151 = 1 % 151 := by
  have hlt : a < 76 := by omega
  exact inverse_checked ⟨a, hlt⟩ ha

