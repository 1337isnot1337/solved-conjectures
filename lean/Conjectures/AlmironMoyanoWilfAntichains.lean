import Conjectures.AlmironMoyanoWilf
import Mathlib.Algebra.Order.Floor.Semiring
import Mathlib.Data.Nat.ModEq
import Mathlib.Tactic

/-! Minimal generators, gap antichains, and the finite Wilf-threshold formulas
from the normalized semimodule classification. -/

open Finset Set

namespace AlmironMoyanoWilf

/-- Elements of a module that cannot be generated from a strictly smaller member. -/
def minimalGenerators (S : AddSubmonoid ℕ) (D : Set ℕ) : Set ℕ :=
  {g | g ∈ D ∧ ∀ e ∈ D, e < g → g - e ∉ S}

/-- The module generated by zero and the specified set. -/
def generated (S : AddSubmonoid ℕ) (A : Set ℕ) : Set ℕ :=
  {n | ∃ a ∈ insert 0 A, ∃ s ∈ S, n = a + s}

theorem generated_isModule (S : AddSubmonoid ℕ) (A : Set ℕ) :
    IsNormalizedModule S (generated S A) := by
  refine ⟨⟨0, mem_insert _ _, 0, S.zero_mem, rfl⟩, ?_⟩
  intro d t
  rintro ⟨a, ha, s, hs, rfl⟩ ht
  exact ⟨a, ha, s + t, S.add_mem hs ht, by omega⟩

theorem zero_mem_minimalGenerators {S : AddSubmonoid ℕ} {D : Set ℕ}
    (hD : IsNormalizedModule S D) : 0 ∈ minimalGenerators S D :=
  ⟨hD.1, fun _ _ h => False.elim (Nat.not_lt_zero _ h)⟩

theorem minimalGenerator_isGap {S : AddSubmonoid ℕ} {D : Set ℕ} {g : ℕ}
    (hD : IsNormalizedModule S D) (hg : g ∈ minimalGenerators S D) (hg0 : g ≠ 0) :
    g ∉ S := by
  exact fun h => hg.2 0 hD.1 (Nat.pos_of_ne_zero hg0) (by simpa using h)

theorem decomposes_into_minimal {S : AddSubmonoid ℕ} {D : Set ℕ}
    {n : ℕ} (hn : n ∈ D) : ∃ g ∈ minimalGenerators S D, ∃ s ∈ S, n = g + s := by
  classical
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hmin : n ∈ minimalGenerators S D
    · exact ⟨n, hmin, 0, S.zero_mem, by simp⟩
    · have hdecomp : ∃ e ∈ D, e < n ∧ n - e ∈ S := by
        simp only [minimalGenerators, mem_ofPred_eq, hn, true_and, not_forall, not_not] at hmin
        obtain ⟨e, he, hen, hes⟩ := hmin
        exact ⟨e, he, hen, hes⟩
      obtain ⟨e, he, hen, hes⟩ := hdecomp
      obtain ⟨g, hg, s, hs, heq⟩ := ih e hen he
      exact ⟨g, hg, s + (n - e), S.add_mem hs hes, by omega⟩

/-- Gap-set antichains for the order induced by nonnegative differences in `S`. -/
def IsGapAntichain (S : AddSubmonoid ℕ) (A : Set ℕ) : Prop :=
  (∀ a ∈ A, a ∉ S) ∧ ∀ a ∈ A, ∀ b ∈ A, a ≤ b → b - a ∈ S → a = b

/-- Normalized modules are generated by zero and their positive minimal generators. -/
theorem positive_minimal_generators {S : AddSubmonoid ℕ} {D : Set ℕ}
    (hD : IsNormalizedModule S D) :
    IsGapAntichain S (minimalGenerators S D \ {0}) ∧
      generated S (minimalGenerators S D \ {0}) = D := by
  constructor
  · constructor
    · intro a ha
      exact minimalGenerator_isGap hD ha.1 ha.2
    · intro a ha b hb hab hS
      exact hab.eq_of_not_lt (fun hlt => hb.1.2 a ha.1.1 hlt hS)
  · ext n
    constructor
    · rintro ⟨a, ha, s, hs, rfl⟩
      rcases mem_insert_iff.1 ha with rfl | ha
      · exact hD.2 0 s hD.1 hs
      · exact hD.2 a s ha.1.1 hs
    · intro hn
      obtain ⟨a, ha, s, hs, heq⟩ := decomposes_into_minimal hn
      by_cases h0 : a = 0
      · exact ⟨a, mem_insert_iff.2 (Or.inl h0), s, hs, heq⟩
      · exact ⟨a, mem_insert_iff.2 (Or.inr ⟨ha, h0⟩), s, hs, heq⟩

/-- Every gap antichain gives precisely the specified positive minimal generators. -/
theorem generated_minimal {S : AddSubmonoid ℕ} {A : Set ℕ} (hA : IsGapAntichain S A) :
    minimalGenerators S (generated S A) = insert 0 A := by
  ext g
  constructor
  · intro hg
    obtain ⟨a, ha, s, hs, heq⟩ := hg.1
    have haD : a ∈ generated S A := ⟨a, ha, 0, S.zero_mem, by simp⟩
    have hag : a = g := by
      by_contra hne
      exact hg.2 a haD (by omega) (by rwa [show g - a = s by omega])
    exact hag ▸ ha
  · intro hg
    rcases mem_insert_iff.1 hg with rfl | hgA
    · exact zero_mem_minimalGenerators (generated_isModule S A)
    refine ⟨⟨g, hg, 0, S.zero_mem, by simp⟩, ?_⟩
    rintro e ⟨a, ha, s, hs, heq⟩ heg hge
    have hag : g - a ∈ S := by
      have h := S.add_mem hs hge
      rwa [show s + (g - e) = g - a by omega] at h
    rcases mem_insert_iff.1 ha with rfl | haA
    · exact hA.1 g hgA (by simpa using hag)
    · have h := hA.2 a haA g hgA (by omega) hag
      omega

theorem minimalGenerators_mod_injective {S : AddSubmonoid ℕ} {D : Set ℕ} {m : ℕ}
    (hm : m ∈ S) : (minimalGenerators S D).InjOn (fun n => n % m) := by
  have haux {a b : ℕ} (ha : a ∈ minimalGenerators S D)
      (hb : b ∈ minimalGenerators S D) (hab : a < b) (heq : a % m = b % m) : False := by
    have hd : m ∣ b - a := Nat.ModEq.dvd' heq
    obtain ⟨j, hj⟩ := hd
    have hmj : m * j ∈ S := by simpa [mul_comm] using multiple_mem hm j
    exact hb.2 a ha.1 hab (hj ▸ hmj)
  intro a ha b hb hab
  rcases lt_trichotomy a b with h | h | h
  · exact False.elim (haux ha hb h hab)
  · exact h
  · exact False.elim (haux hb ha h hab.symm)

theorem minimalGenerators_card_le {S : AddSubmonoid ℕ} {D : Set ℕ} {m : ℕ}
    (hm : IsMultiplicity S m) : (minimalGenerators S D).ncard ≤ m := by
  calc
    _ ≤ (Finset.range m : Set ℕ).ncard :=
      Set.ncard_le_ncard_of_injOn (fun n => n % m)
        (fun n _ => Finset.mem_range.2 (Nat.mod_lt n hm.1))
        (minimalGenerators_mod_injective hm.2.1) (Finset.range m).finite_toSet
    _ = m := by rw [Set.ncard_coe_finset, Finset.card_range]

/-- The finite gap set, with cutoff given by the actual conductor. -/
noncomputable def gaps (D : Set ℕ) (c : ℕ) : Finset ℕ := by
  classical
  exact (range c).filter fun n => n ∉ D

theorem mem_gaps_iff {D : Set ℕ} {c n : ℕ} (hc : IsConductor (fun n => n ∈ D) c) :
    n ∈ gaps D c ↔ n ∉ D := by
  classical
  simp only [gaps, mem_filter, Finset.mem_range]
  exact ⟨And.right, fun h => ⟨lt_of_not_ge (fun hn => h (hc.1 n hn)), h⟩⟩

theorem generated_gaps_iff {S : AddSubmonoid ℕ} {A : Set ℕ} {c g : ℕ}
    (hc : IsConductor (fun n => n ∈ generated S A) c) :
    g ∈ gaps (generated S A) c ↔ g ∉ S ∧ ¬∃ a ∈ A, a ≤ g ∧ g - a ∈ S := by
  rw [mem_gaps_iff hc]
  constructor
  · intro hg
    refine ⟨fun hs => hg ⟨0, mem_insert _ _, g, hs, (Nat.zero_add g).symm⟩, ?_⟩
    rintro ⟨a, ha, hag, hS'⟩
    exact hg ⟨a, mem_insert_iff.2 (Or.inr ha), g - a, hS', by omega⟩
  · rintro ⟨hg, hnot⟩ ⟨a, ha, s, hs, heq⟩
    rcases mem_insert_iff.1 ha with rfl | ha
    · exact hg (by simpa [heq] using hs)
    · exact hnot ⟨a, ha, by omega, by rwa [show g - a = s by omega]⟩

theorem leftCount_add_gaps (D : Set ℕ) (c : ℕ) [DecidablePred (fun n => n ∈ D)] :
    leftCount (fun n => n ∈ D) c + (gaps D c).card = c := by
  let decNot : DecidablePred (fun n : ℕ => n ∉ D) := fun _ => Classical.propDecidable _
  have hg : (@Finset.filter ℕ (fun n => n ∉ D) decNot (Finset.range c)) = gaps D c := by
    ext n
    simp only [gaps, Finset.mem_filter]
  rw [← hg]
  unfold leftCount
  simpa only [card_range] using
    @card_filter_add_card_filter_not ℕ (Finset.range c) (fun n => n ∈ D) inferInstance decNot

theorem conductor_eq_gapMax {D : Set ℕ} {c : ℕ} (hc : IsConductor (fun n => n ∈ D) c)
    (hne : (gaps D c).Nonempty) :
    c = (gaps D c).max' hne + 1 := by
  have hmax : (gaps D c).max' hne ∉ D := (mem_gaps_iff hc).1 (max'_mem _ _)
  apply isConductor_unique hc (isConductor_of_last_gap _ ?_ ?_)
  · intro n hn
    by_contra h
    have := le_max' _ n ((mem_gaps_iff hc).2 h)
    omega
  · simpa using hmax

theorem leftCount_pos {D : Set ℕ} [DecidablePred (fun n => n ∈ D)] (h0 : 0 ∈ D)
    {c : ℕ} (hc : 0 < c) : 0 < leftCount (fun n => n ∈ D) c := by
  unfold leftCount
  exact card_pos.2 ⟨0, mem_filter.2 ⟨Finset.mem_range.2 hc, h0⟩⟩

/-- The exact threshold from an individual module's last gap and gap count. -/
theorem gap_threshold {D : Set ℕ} {c : ℕ} [DecidablePred (fun n => n ∈ D)]
    (hc : IsConductor (fun n => n ∈ D) c) (h0 : 0 ∈ D)
    (hne : (gaps D c).Nonempty) :
    let b := (gaps D c).max' hne + 1
    IsLeast {k : ℕ | 0 < k ∧ c ≤ k * leftCount (fun n => n ∈ D) c}
      ⌈(b : ℚ) / ((b - (gaps D c).card : ℕ) : ℚ)⌉₊ := by
  dsimp only
  rw [← conductor_eq_gapMax hc hne]
  have hc' : 0 < c := by rw [conductor_eq_gapMax hc hne]; omega
  have hcount := leftCount_add_gaps D c
  rw [show c - (gaps D c).card = leftCount (fun n => n ∈ D) c by omega]
  let δ := leftCount (fun n => n ∈ D) c
  have hδ : (0 : ℚ) < δ := by exact_mod_cast leftCount_pos h0 hc'
  have hfrac : (0 : ℚ) < (c : ℚ) / δ := by positivity
  have hequiv (k : ℕ) : c ≤ k * δ ↔ (c : ℚ) / δ ≤ k := by
    rw [div_le_iff₀ hδ, ← Nat.cast_mul]
    exact_mod_cast (Iff.rfl : c ≤ k * δ ↔ c ≤ k * δ)
  constructor
  · exact ⟨Nat.ceil_pos.2 hfrac, (hequiv _).2 (Nat.le_ceil _)⟩
  · rintro k ⟨_, hk⟩
    exact Nat.ceil_le.2 ((hequiv k).1 hk)

theorem wilf_at_generator_count_iff (D : Set ℕ) (c : ℕ) [DecidablePred (fun n => n ∈ D)]
    {r : ℕ} (hr : 0 < r) :
    c ≤ r * leftCount (fun n => n ∈ D) c ↔ r * (gaps D c).card ≤ (r - 1) * c := by
  have h := congrArg (r * ·) (leftCount_add_gaps D c)
  rw [Nat.mul_add] at h
  have hr' : r * c = (r - 1) * c + c := by
    rw [← Nat.succ_mul, show (r - 1).succ = r by omega]
  omega

end AlmironMoyanoWilf
