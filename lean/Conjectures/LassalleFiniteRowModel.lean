def candidateInverse (k : ℕ) : ℤ := inverseCandidate[k]?.getD 0

def checkedInverseAt (k : ℕ) : Prop :=
  candidateInverse (k+1) =
    -∑ i : Fin (k+1), (chooseFast (2*(k+1)) (2*(i.val+1)) : ℤ) *
      signedCatalan (i.val+1) * candidateInverse (k+1-(i.val+1))

instance checkedInverseAtDecidable (k : ℕ) : Decidable (checkedInverseAt k) :=
  inferInstanceAs (Decidable (_=_))

def inverseCandidateChecked : Prop :=
  (List.range 53).all (fun k => decide (checkedInverseAt k)) = true

theorem candidateInverse_zero : candidateInverse 0 = 1 := by decide +kernel

theorem candidateInverse_correct (h : inverseCandidateChecked) (k : ℕ) (hk : k<54) :
    candidateInverse k = inverseCatalan k := by
  induction k using Nat.strong_induction_on with
  | h k ih =>
    cases k with
    | zero => rw [candidateInverse_zero,inverseCatalan_zero]
    | succ k =>
      have hkm : k∈List.range 53 := List.mem_range.mpr (by omega)
      have he := of_decide_eq_true (List.all_eq_true.mp h k hkm)
      change checkedInverseAt k at he
      have hm (i : Fin (k+1)) : candidateInverse (k+1-(i.val+1)) = inverseCatalan (k+1-(i.val+1)) :=
        ih _ (by have hh := i.isLt; omega) (by omega)
      have hsum :
          (∑ i : Fin (k+1), (chooseFast (2*(k+1)) (2*(i.val+1)) : ℤ) *
            signedCatalan (i.val+1) * candidateInverse (k+1-(i.val+1))) =
          ∑ i : Fin (k+1), (chooseFast (2*(k+1)) (2*(i.val+1)) : ℤ) *
            signedCatalan (i.val+1) * inverseCatalan (k+1-(i.val+1)) := by
        apply Finset.sum_congr rfl
        intro i _
        rw [hm i]
      exact he.trans ((congrArg (fun x : ℤ => -x) hsum).trans (inverseCatalan_succ k).symm)

def quotientCandidate (k a : ℕ) : ℤ :=
  ∑ i ∈ Finset.range (a/2+1), ∑ j ∈ Finset.range ((2*k-a)/2+1),
    (chooseFast a (2*i):ℤ)*(chooseFast (2*k-a) (2*j):ℤ)*
    signedCatalan i * signedCatalan j * candidateInverse (k-i-j)

theorem quotientCandidate_eq (h : inverseCandidateChecked) (k a : ℕ) (hk : k<54) :
    quotientCandidate k a = quotientRow k a := by
  unfold quotientCandidate quotientRow
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  rw [candidateInverse_correct h _ (by omega)]

