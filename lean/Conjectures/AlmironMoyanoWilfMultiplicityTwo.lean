import Conjectures.AlmironMoyanoWilf
import Mathlib.Algebra.Group.Submonoid.Membership

/-! Exact two-generator module thresholds over a semigroup of multiplicity two. -/

namespace AlmironMoyanoWilf

/-- The actual numerical semigroup generated by 2 and b. -/
abbrev twoOdd (b : ℕ) : AddSubmonoid ℕ := AddSubmonoid.closure ({2, b} : Set ℕ)

theorem mem_twoOdd_iff {b n : ℕ} (hb : b % 2 = 1) :
    n ∈ twoOdd b ↔ n % 2 = 0 ∨ b ≤ n := by
  rw [twoOdd, AddSubmonoid.mem_closure_pair]
  simp only [Nat.nsmul_eq_mul]
  constructor
  · rintro ⟨i, j, rfl⟩
    by_cases h : j = 0
    · subst j
      simp
    · right
      have : b ≤ j * b := by
        simpa using Nat.mul_le_mul_right b (show 1 ≤ j by omega)
      omega
  · intro h
    by_cases he : n % 2 = 0
    · exact ⟨n / 2, 0, by simp; omega⟩
    · have hn : b ≤ n := h.resolve_left he
      exact ⟨(n - b) / 2, 1, by simp; omega⟩

private theorem twoOdd_gapModule {b g n : ℕ} (hb : b % 2 = 1) (hg : g ∉ twoOdd b) :
    gapModule (fun x => x ∈ twoOdd b) g n ↔ n % 2 = 0 ∨ g ≤ n := by
  rw [mem_twoOdd_iff hb] at hg
  simp only [gapModule, mem_twoOdd_iff hb]
  omega

open Classical in
theorem twoOdd_module_rows {b g : ℕ} (hb : b % 2 = 1) (hg : g ∉ twoOdd b) :
    IsConductor (gapModule (fun x => x ∈ twoOdd b) g) (g - 1) ∧
    2 * leftCount (gapModule (fun x => x ∈ twoOdd b) g) (g - 1) = g - 1 := by
  classical
  have hodd : g % 2 = 1 := by rw [mem_twoOdd_iff hb] at hg; omega
  constructor
  · constructor
    · intro n hn
      rw [twoOdd_gapModule hb hg]
      omega
    · intro k hk
      refine ⟨g - 2, by omega, ?_⟩
      rw [twoOdd_gapModule hb hg]
      omega
  · let twice : ℕ ↪ ℕ := ⟨fun i => 2 * i, fun i j e => by change 2 * i = 2 * j at e; omega⟩
    have hset : (Finset.range (g - 1)).filter (gapModule (fun x => x ∈ twoOdd b) g) =
        (Finset.range ((g - 1) / 2)).map twice := by
      ext n
      simp only [Finset.mem_filter, Finset.mem_range, twoOdd_gapModule hb hg, Finset.mem_map]
      constructor
      · rintro ⟨hn, h⟩
        exact ⟨n / 2, by simpa only [Finset.mem_range] using (show n / 2 < (g - 1) / 2 by omega),
          show 2 * (n / 2) = n by omega⟩
      · rintro ⟨i, hi, rfl⟩
        change i < (g - 1) / 2 at hi
        change 2 * i < g - 1 ∧ (2 * i % 2 = 0 ∨ g ≤ 2 * i)
        omega
    rw [leftCount, hset, Finset.card_map, Finset.card_range]
    omega

open Classical in
/-- Across every gap g of a two-generated semigroup of multiplicity two,
the least positive threshold is 1 for ⟨2,3⟩ and 2 for every larger odd b. -/
theorem twoOdd_gap_threshold {b : ℕ} (hb : b % 2 = 1) (hb3 : 3 ≤ b) :
    IsLeast {k : ℕ | 0 < k ∧ ∀ g c, g ∉ twoOdd b →
        IsConductor (gapModule (fun x => x ∈ twoOdd b) g) c →
        c ≤ k * leftCount (gapModule (fun x => x ∈ twoOdd b) g) c}
      (if b = 3 then 1 else 2) := by
  classical
  constructor
  · refine ⟨by split <;> omega, ?_⟩
    intro g c hg hc
    obtain ⟨hc', hd⟩ := twoOdd_module_rows hb hg
    obtain rfl := isConductor_unique hc' hc
    split
    · next he =>
      have h := mt (mem_twoOdd_iff hb).2 hg
      have hg1 : g = 1 := by omega
      simp [hg1]
    · exact hd.ge
  · intro k hk
    obtain ⟨hkpos, hkall⟩ := hk
    split
    · omega
    · next h =>
      have hg : 3 ∉ twoOdd b := by rw [mem_twoOdd_iff hb]; omega
      obtain ⟨hc, hd⟩ := twoOdd_module_rows hb hg
      have he : leftCount (gapModule (fun x => x ∈ twoOdd b) 3) (3 - 1) = 1 := by omega
      have hw := hkall 3 (3 - 1) hg hc
      simpa [he] using hw

end AlmironMoyanoWilf
