set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem permutationTable_eq :
    (permsOfList (List.finRange 5)).map (fun p => fun i => p i) = permutationTable := by
  decide +kernel

def tableCandidate (j : Fin 8) (p : Fin 5 → Fin 5) (mask : Fin 16) : Vector :=
  fun i => signs mask i * canonical j (p i)

def staticCaseCheck (i j : Fin 8) : Bool :=
  permutationTable.all fun p =>
    (List.finRange 16).all fun mask => pairTest (canonical i) (tableCandidate j p mask)

end Loneliness.PlaneCertificate
