noncomputable def certificate (m : Fin 256) : FastRow := rowData.get m.val

private theorem rows_valid_block_0 : ∀ j : Fin 64,
    FastValid 12 bounds (fun i => (3584+(0*64+j.val)).testBit i.val)
      (certificate ⟨0*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_1 : ∀ j : Fin 64,
    FastValid 12 bounds (fun i => (3584+(1*64+j.val)).testBit i.val)
      (certificate ⟨1*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_2 : ∀ j : Fin 64,
    FastValid 12 bounds (fun i => (3584+(2*64+j.val)).testBit i.val)
      (certificate ⟨2*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_3 : ∀ j : Fin 64,
    FastValid 12 bounds (fun i => (3584+(3*64+j.val)).testBit i.val)
      (certificate ⟨3*64+j.val, by omega⟩) := by decide +kernel

theorem rows_valid (m : Fin 256) :
    FastValid 12 bounds (fun i => (3584+m.val).testBit i.val) (certificate m) := by
  let q := m.val / 64
  let j : Fin 64 := ⟨m.val % 64, Nat.mod_lt _ (by decide)⟩
  have hq : q < 4 := by dsimp [q]; omega
  have he : m.val = q*64+j.val := by dsimp [q,j]; omega
  interval_cases q
  · have hm : m = ⟨0*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_0 j
  · have hm : m = ⟨1*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_1 j
  · have hm : m = ⟨2*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_2 j
  · have hm : m = ⟨3*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_3 j

end Loneliness.KZProduct.Thirteen.Block14
