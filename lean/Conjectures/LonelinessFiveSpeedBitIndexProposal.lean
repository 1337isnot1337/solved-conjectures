import Init.Data.Nat.Bitwise

/-! A finite bit-index proposal for masks below 2^1789. The caller must
check the proposed bit against its actual mask. No theorem in this module
asserts completeness or correctness of the table. -/

namespace Loneliness.FiveSpeedCertificate

/-- The 11-bit field at index `2^t % 1861` contains the proposal `t`.
This literal is untrusted proposal data; every use is checked by the caller. -/
def packedBitIndexTable : Nat := 

/-- Propose a set-bit position with primitive arithmetic and a packed lookup.
The soundness of a consumer must not depend on this proposal being correct. -/
def proposedPackedFirstBit (mask : Nat) : Nat :=
  let lowbit := ((mask ^^^ (mask - 1)) + 1) / 2
  (packedBitIndexTable >>> (11 * (lowbit % 1861))) &&& 2047

end Loneliness.FiveSpeedCertificate
