import Conjectures.HadamardAutomorphismCyclotomic
import Mathlib.RingTheory.DedekindDomain.Factorization

/-! The two actual primes above 599 are distinct, unramified, and comaximal.
Their intersection is the principal ideal generated by 599. -/

noncomputable section

namespace HadamardAutomorphism

open NumberField IsCyclotomicExtension
open scoped Pointwise

variable (K : Type*) [Field K] [NumberField K]
  [IsCyclotomicExtension {479} ℚ K]

local instance splittingPrime599Fact : Fact (Nat.Prime 599) := ⟨prime_599⟩

theorem prime599_individual_ramification (P : Ideal (𝓞 K)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(599 : ℤ)})] : P.ramificationIdx ℤ = 1 := by
  let : IsGalois ℚ K := IsCyclotomicExtension.isGalois {479} ℚ K
  rw [← Ideal.ramificationIdxIn_eq_ramificationIdx
    (Ideal.span {(599 : ℤ)}) P (K ≃ₐ[ℚ] K)]
  exact prime599_ramification_index K

theorem prime599_ideal_factorization (P : Ideal (𝓞 K)) [P.IsMaximal]
    [P.LiesOver (Ideal.span {(599 : ℤ)})] :
    Ideal.span {(599 : 𝓞 K)} = P * (conjugation479 K • P) := by
  classical
  have hp : (Ideal.span {(599 : ℤ)}) ≠ 0 := by
    rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    norm_num
  have h := Ideal.map_algebraMap_eq_finsetProd_pow (R := 𝓞 K) hp
  have hne : P ≠ conjugation479 K • P := (conjugation479_moves_prime K P).symm
  simpa [Ideal.map_span, prime599_primes_eq_pair K P, hne,
    prime599_individual_ramification K P,
    prime599_individual_ramification K (conjugation479 K • P)] using h

theorem prime599_ideal_intersection (P : Ideal (𝓞 K)) [P.IsMaximal]
    [P.LiesOver (Ideal.span {(599 : ℤ)})] :
    P ⊓ (conjugation479 K • P) = Ideal.span {(599 : 𝓞 K)} := by
  have hmax : (conjugation479 K • P).IsMaximal :=
    Ideal.IsMaximal.of_liesOver_isMaximal (conjugation479 K • P)
      (Ideal.span {(599 : ℤ)})
  have hcop := Ideal.IsMaximal.coprime_of_ne
    (inferInstance : P.IsMaximal) hmax (conjugation479_moves_prime K P).symm
  rw [← Ideal.mul_eq_inf_of_coprime hcop]
  exact (prime599_ideal_factorization K P).symm

end HadamardAutomorphism
