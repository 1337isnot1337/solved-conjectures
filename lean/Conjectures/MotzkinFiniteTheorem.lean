import Conjectures.MotzkinFinite
import Conjectures.MotzkinCharacterLower
import Mathlib.MeasureTheory.Measure.Count
import Mathlib.Data.Finset.Max

/-! The exact two-difference character theorem for every finite abelian group
generated by the two marked elements, with both optimizing objects attained. -/
namespace Motzkin

open MeasureTheory MeasureTheory.Measure
open scoped ENNReal

variable {G : Type*} [AddCommGroup G] [Fintype G]

theorem finite_character_independent (a b : G) (χ : G →+ UnitAddCircle) :
    ∃ A : Finset G, (∀ x ∈ A, x+a ∉ A ∧ x+b ∉ A) ∧
      min ‖χ a‖ ‖χ b‖ ≤ (A.card:ℝ)/(Fintype.card G:ℝ) := by
  classical
  let : MeasurableSpace G := ⊤
  let : MeasurableSingletonClass G := ⟨fun _ => trivial⟩
  let μ : Measure G := ((count : Measure G) Set.univ)⁻¹ • count
  let : IsProbabilityMeasure μ := inferInstance
  have huniv : (count : Measure G) Set.univ = (Fintype.card G : ℝ≥0∞) := by
    simpa only [Finset.coe_univ,Finset.card_univ] using
      (count_apply_finset (Finset.univ : Finset G))
  have hratio : ∀ A : Set G, μ.real A = ((Set.toFinite A).toFinset.card:ℝ)/(Fintype.card G:ℝ) := by
    intro A
    change ((((count : Measure G) Set.univ)⁻¹ • (count : Measure G)) A).toReal = _
    rw [Measure.smul_apply,smul_eq_mul,huniv,count_apply_finite A (Set.toFinite A)]
    simp [ENNReal.toReal_mul,ENNReal.toReal_inv,div_eq_mul_inv,mul_comm]
  obtain ⟨A,hmeas,hA,hval⟩ := character_lower_bound μ χ measurable_from_top a b
  refine ⟨(Set.toFinite A).toFinset,?_,?_⟩
  · intro x hx
    have hxA : x ∈ A := by simpa using hx
    have hh := hA x hxA
    simpa using hh
  · rwa [hratio A] at hval

theorem exists_maximum_independent (a b : G) :
    ∃ A : Finset G, (∀ x ∈ A, x+a ∉ A ∧ x+b ∉ A) ∧
      ∀ B : Finset G, (∀ x ∈ B, x+a ∉ B ∧ x+b ∉ B) → B.card ≤ A.card := by
  classical
  let S : Finset (Finset G) := (Finset.univ.powerset).filter
    (fun A => ∀ x ∈ A, x+a ∉ A ∧ x+b ∉ A)
  have hmem : ∀ A : Finset G, A ∈ S ↔ (∀ x ∈ A, x+a ∉ A ∧ x+b ∉ A) := by
    intro A
    simp only [S,Finset.mem_filter,Finset.mem_powerset,Finset.subset_univ,true_and]
  have hS : S.Nonempty := by
    refine ⟨∅,(hmem ∅).mpr ?_⟩
    simp
  obtain ⟨A,hA,hmax⟩ := Finset.exists_max_image S Finset.card hS
  exact ⟨A,(hmem A).mp hA,fun B hB => hmax B ((hmem B).mpr hB)⟩

/-- Exact finite Motzkin density and character maximization. The independent
set and character are both actual attaining witnesses. -/
theorem finite_two_difference_theorem (a b : G)
    (hgen : AddSubgroup.closure ({a,b} : Set G)=⊤) :
    ∃ A : Finset G, ∃ χ : G →+ UnitAddCircle,
      (∀ x ∈ A, x+a ∉ A ∧ x+b ∉ A) ∧
      (A.card:ℝ)/(Fintype.card G:ℝ)=min ‖χ a‖ ‖χ b‖ ∧
      (∀ B : Finset G, (∀ x ∈ B, x+a ∉ B ∧ x+b ∉ B) → B.card ≤ A.card) ∧
      ∀ ψ : G →+ UnitAddCircle, min ‖ψ a‖ ‖ψ b‖ ≤ min ‖χ a‖ ‖χ b‖ := by
  obtain ⟨A,hA,hmax⟩ := exists_maximum_independent a b
  obtain ⟨χ,hχ⟩ := finite_independent_character a b hgen A hA
  have hupper : ∀ ψ : G →+ UnitAddCircle,
      min ‖ψ a‖ ‖ψ b‖ ≤ (A.card:ℝ)/(Fintype.card G:ℝ) := by
    intro ψ
    obtain ⟨B,hB,hψ⟩ := finite_character_independent a b ψ
    have hc : (B.card:ℝ) ≤ A.card := by exact_mod_cast hmax B hB
    exact hψ.trans (div_le_div_of_nonneg_right hc (Nat.cast_nonneg _))
  have he := le_antisymm hχ (hupper χ)
  exact ⟨A,χ,hA,he,hmax,fun ψ => (hupper ψ).trans he.le⟩

end Motzkin
