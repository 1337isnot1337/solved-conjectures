import Conjectures.LonelinessKZProductFast
import Mathlib.Tactic.FinCases
import Init.Data.RArray

/-! Shared exact prefix bounds for the partitioned twelve-dimensional
dual certificate. Generated by scripts/generate_loneliness_kz_certificates.py. -/

namespace Loneliness.KZProduct.Thirteen

def boundScale : ℕ := 32464832400
def boundData : Array ℕ := #[0, 3920400, 18404100, 49280400, 106007616, 204490000, 372683025, 662547600, 1177862400, 2146654224, 4140922500, 8907584400, 23851713600]
def bounds (r : ℕ) : ℕ := boundData[r]?.getD 0

noncomputable def assembleCertificate (blocks : Fin 16 → Fin 256 → FastRow)
    (m : Fin (2^12)) : FastRow :=
  blocks ⟨m.val / 256, by omega⟩ ⟨m.val % 256, Nat.mod_lt _ (by decide)⟩

theorem assemble_valid (blocks : Fin 16 → Fin 256 → FastRow)
    (hblocks : ∀ b m, FastValid 12 bounds
      (fun i => (b.val*256+m.val).testBit i.val) (blocks b m))
    (m : Fin (2^12)) :
    FastValid 12 bounds (fun i => m.val.testBit i.val) (assembleCertificate blocks m) := by
  let q : Fin 16 := ⟨m.val / 256, by omega⟩
  let j : Fin 256 := ⟨m.val % 256, Nat.mod_lt _ (by decide)⟩
  have he : q.val*256+j.val = m.val := by dsimp [q,j]; omega
  change FastValid 12 bounds (fun i => m.val.testBit i.val) (blocks q j)
  simpa only [he] using hblocks q j

end Loneliness.KZProduct.Thirteen
