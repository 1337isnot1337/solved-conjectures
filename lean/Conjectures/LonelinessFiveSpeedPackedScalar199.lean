import Conjectures.LonelinessFiveSpeedPackedScalar
import Conjectures.LonelinessFiveSpeedScalarTreeMask0199

set_option maxRecDepth 20000
set_option maxHeartbeats 0
set_option Elab.async false

namespace Loneliness.FiveSpeedCertificate.PackedScalars.P199

/-! A literal packed oracle. Its finite equality certificate is checked
against the existing scalar tree, including the zero block. -/

noncomputable def packed : ℕ := nat_lit 

noncomputable def mask : ℕ → ℕ := packedScalarMask 199 packed

theorem checked :
    packedScalarTreeCheck 199 packed ScalarTrees.P199.tree = true := by
  decide +kernel

theorem mask_eq_treeMask :
    mask = treeMask 199 ScalarTrees.P199.tree :=
  packedScalarMask_eq_treeMask_function 199 packed ScalarTrees.P199.tree checked

theorem sound (a : ℕ) : GoodMask 199 a (mask a) :=
  packedScalarTreeCheck_sound 199 packed ScalarTrees.P199.tree
    ScalarTrees.P199.checked checked a

end Loneliness.FiveSpeedCertificate.PackedScalars.P199
