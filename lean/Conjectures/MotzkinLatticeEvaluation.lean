import Conjectures.MotzkinLattice
import Conjectures.MotzkinRankTwoRelations

/-! Unconditional classification of the actual relation kernel. The supplied
generators in the checked rank formulas are constructed for every pair of
elements, so the three value formulas exhaust all compact abelian groups. -/
namespace Motzkin

open MeasureTheory MeasureTheory.Measure

theorem relation_lattice_two_generated {G : Type*} [AddCommGroup G] (a b : G) :
    ∃ p q : ℤ × ℤ, (pairSum a b).ker=AddSubgroup.closure ({p,q} : Set (ℤ × ℤ)) :=
  Lattice.subgroup_two_generated (pairSum a b).ker

/-- Every relation kernel is zero, generated by one nonzero integral vector,
or given by a normalized Hermite basis with positive diagonal entries. -/
theorem relation_lattice_trichotomy {G : Type*} [AddCommGroup G] (a b : G) :
    (∀ r t : ℤ, r • a+t • b=0 ↔ r=0 ∧ t=0) ∨
    (∃ u v : ℤ, 0 < u.natAbs+v.natAbs ∧
      ∀ r t : ℤ, r • a+t • b=0 ↔ ∃ n : ℤ, r=n*u ∧ t=n*v) ∨
    (∃ m k s : ℕ, 0 < m ∧ 0 < k ∧ s < m ∧
      ∀ r t : ℤ, r • a+t • b=0 ↔
        ∃ u v : ℤ, r=u*(m:ℤ)+v*(s:ℤ) ∧ t=v*(k:ℤ)) := by
  rcases Lattice.subgroup_trichotomy (pairSum a b).ker with hzero | hone | htwo
  · left
    intro r t
    change (r,t) ∈ (pairSum a b).ker ↔ r=0 ∧ t=0
    rw [hzero,AddSubgroup.mem_bot]
    change (r,t)=(0,0) ↔ r=0 ∧ t=0
    constructor
    · intro h
      exact ⟨congrArg Prod.fst h,congrArg Prod.snd h⟩
    · rintro ⟨rfl,rfl⟩
      rfl
  · exact Or.inr (Or.inl hone)
  · exact Or.inr (Or.inr htwo)

/-- The rank formulas form an exhaustive evaluation theorem, with all
relation generators constructed from the original pair rather than assumed. -/
theorem compact_density_trichotomy {G : Type*} [AddCommGroup G]
    [TopologicalSpace G] [IsTopologicalAddGroup G] [CompactSpace G] [T2Space G]
    [MeasurableSpace G] [BorelSpace G]
    (μ : Measure G) [IsProbabilityMeasure μ] [IsAddLeftInvariant μ] (a b : G) :
    ((∀ r t : ℤ, r • a+t • b=0 ↔ r=0 ∧ t=0) ∧ density μ a b=1/2) ∨
    (∃ u v : ℤ, 0 < u.natAbs+v.natAbs ∧
      (∀ r t : ℤ, r • a+t • b=0 ↔ ∃ n : ℤ, r=n*u ∧ t=n*v) ∧
      density μ a b=((u.natAbs+v.natAbs)/2:ℕ)/((u.natAbs+v.natAbs:ℕ):ℝ)) ∨
    (∃ m k s : ℕ, 0 < m ∧ 0 < k ∧ s < m ∧
      (∀ r t : ℤ, r • a+t • b=0 ↔
        ∃ u v : ℤ, r=u*(m:ℤ)+v*(s:ℤ) ∧ t=v*(k:ℤ)) ∧
      ∃ i : Fin m, ∃ j : Fin k,
        density μ a b=
          min ‖(rankTwoPoint m k (s:ℤ) i j).1‖ ‖(rankTwoPoint m k (s:ℤ) i j).2‖ ∧
        ∀ i' : Fin m, ∀ j' : Fin k,
          min ‖(rankTwoPoint m k (s:ℤ) i' j').1‖ ‖(rankTwoPoint m k (s:ℤ) i' j').2‖ ≤
            density μ a b) := by
  rcases relation_lattice_trichotomy a b with
    hzero | ⟨u,v,hpos,hform⟩ | ⟨m,k,s,hm,hk,hs,hform⟩
  · left
    exact ⟨hzero,rank_zero_density μ a b (fun r t h => (hzero r t).mp h)⟩
  · right
    left
    refine ⟨u,v,hpos,hform,?_⟩
    exact rank_one_density μ a b u v hpos
      ((hform u v).mpr ⟨1,by ring,by ring⟩) (fun r t => (hform r t).mp)
  · right
    right
    refine ⟨m,k,s,hm,hk,hs,hform,?_⟩
    have hma : m • a=0 := by
      have h := (hform (m:ℤ) 0).mpr ⟨1,0,by ring,by ring⟩
      simpa only [natCast_zsmul,zero_zsmul,add_zero] using h
    have hskb : (s:ℤ) • a+k • b=0 := by
      have h := (hform (s:ℤ) (k:ℤ)).mpr ⟨0,1,by ring,by ring⟩
      simpa only [natCast_zsmul] using h
    exact rank_two_density μ a b m k (s:ℤ) hm hk hma hskb
      (fun r t => (hform r t).mp)

end Motzkin
