  decide +kernel

theorem inverse_valid (a : ℕ) (ha : 0 < a) (hbound : 2 * a ≤ 167) :
    (a * inverse a) % 167 = 1 % 167 := by
  have hlt : a < 84 := by omega
  exact inverse_checked ⟨a, hlt⟩ ha

