import Conjectures.ErdosGyarfasVoltageNormalization
import Mathlib.Data.List.Chain
import Mathlib.Data.Fintype.Pi
import Mathlib.Data.List.Nodup

/-!
# A finite checker for universal abelian-cover cycle descent

Each node supplies an actual integer-coordinate walk and explicit integer
combinations. A collision is covered by a branch to an earlier node whose
rows lie in the group generated by the old rows and that collision vector.
The checker makes no use of normal forms or a lattice-membership oracle.
-/

namespace ErdosGyarfasUniversal

open ErdosGyarfasVoltage

abbrev Position := Fin 5 × Vector

/-- Equality of chord vectors is the reducible finite-coordinate decision. -/
instance vectorDecidableEq : DecidableEq Vector := Fintype.decidablePiFintype

structure Branch where
  left : Position
  right : Position
  child : ℕ
  combinations : List (List ℤ)
  deriving Inhabited

structure Node where
  rows : List Vector
  start : Fin 5
  middle : List Position
  total : Vector
  closing : List ℤ
  branches : List Branch
  deriving Inhabited

def Node.prefix (n : Node) : List Position := (n.start, 0) :: n.middle

def Node.support (n : Node) : List Position :=
  n.prefix ++ [(n.start, n.total)]

def combination (coeffs : List ℤ) (rows : List Vector) : Vector :=
  (List.zipWith (fun a v => a • v) coeffs rows).sum

/-- Consecutive positions use an actual base edge and its exact chord count. -/
def Step (p q : Position) : Prop :=
  ErdosGyarfasSharp.baseGraph.Adj p.1 q.1 ∧
    q.2 = p.2 + chordStep p.1 q.1

instance stepDecidable : DecidableRel Step := fun _ _ =>
  inferInstanceAs (Decidable (_ ∧ _))

/-- Coefficient lengths and every claimed row combination are checked. -/
def combinationsCheck (sources : List Vector) :
    List Vector → List (List ℤ) → Bool
  | [], [] => true
  | row :: rows, coeffs :: rest =>
      decide (coeffs.length = sources.length ∧ row = combination coeffs sources) &&
        combinationsCheck sources rows rest
  | _, _ => false

def branchCheck (lookup : ℕ → Node) (bound : ℕ) (rows : List Vector)
    (b : Branch) : Bool :=
  decide (b.child < bound) &&
    combinationsCheck ((b.right.2 - b.left.2) :: rows)
      (lookup b.child).rows b.combinations

def branchMatches (b : Branch) (p q : Position) : Bool :=
  decide ((b.left = p ∧ b.right = q) ∨ (b.left = q ∧ b.right = p))

def pairCovered (branches : List Branch) (p q : Position) : Bool :=
  if p.1 = q.1 ∧ p ≠ q then branches.any (fun b => branchMatches b p q)
  else true

def coverageCheck (prefix : List Position) (branches : List Branch) : Bool :=
  prefix.all fun p => prefix.all fun q => pairCovered branches p q

def LocalValid (n : Node) : Prop :=
  n.prefix.length ∈ [4, 8, 16, 32] ∧ n.prefix.Nodup ∧
    n.support.IsChain Step ∧ n.closing.length = n.rows.length ∧
    combination n.closing n.rows = n.total

instance localValidDecidable (n : Node) : Decidable (LocalValid n) :=
  inferInstanceAs (Decidable (_ ∧ _))

/-- One bounded descent node, including complete collision coverage. -/
def checkNode (lookup : ℕ → Node) (index : ℕ) : Bool :=
  decide (LocalValid (lookup index)) &&
    (lookup index).branches.all (branchCheck lookup index (lookup index).rows) &&
    coverageCheck (lookup index).prefix (lookup index).branches

end ErdosGyarfasUniversal
