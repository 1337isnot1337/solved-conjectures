module

public import Conjectures.ShumyatskyPrimeSpectrum
public import Conjectures.ShumyatskyWalkLabels
public import Mathlib.GroupTheory.Subgroup.Center

/-! Restrict the stabilizer of one simple factor to that factor, and
transport its prime spectrum to the subgroup generated by two conjugates. -/

@[expose] public section

namespace Shumyatsky

variable {ι S : Type*} [Group S] [DecidableEq ι]

local notation "singleFactor" => Pi.mulSingle (M := fun _ : ι => S)

/-- The product automorphisms which restrict to automorphisms of factor i. -/
def factorStabilizer (i : ι) : Subgroup (MulAut (ι → S)) where
  carrier := {e | ∃ a : MulAut S, ∀ s, e (singleFactor i s) = singleFactor i (a s)}
  one_mem' := ⟨1, fun _ => rfl⟩
  mul_mem' := by
    rintro e f ⟨a, ha⟩ ⟨b, hb⟩
    refine ⟨a * b, fun s => ?_⟩
    change e (f (singleFactor i s)) = singleFactor i (a (b s))
    rw [hb, ha]
  inv_mem' := by
    rintro e ⟨a, ha⟩
    refine ⟨a⁻¹, fun s => e.injective ?_⟩
    rw [MulAut.apply_inv_self, ha, MulAut.apply_inv_self]

private theorem restriction_unique (i : ι) (e : MulAut (ι → S)) (a b : MulAut S)
    (ha : ∀ s, e (singleFactor i s) = singleFactor i (a s))
    (hb : ∀ s, e (singleFactor i s) = singleFactor i (b s)) : a = b :=
  MulEquiv.ext fun s => Pi.mulSingle_injective i ((ha s).symm.trans (hb s))

/-- Restriction to the coordinate is a group homomorphism. -/
noncomputable def factorRestriction (i : ι) : factorStabilizer (S := S) i →* MulAut S where
  toFun e := Classical.choose e.property
  map_one' := by
    apply restriction_unique i 1
    · exact Classical.choose_spec (1 : factorStabilizer (S := S) i).property
    · intro s
      rfl
  map_mul' e f := by
    apply restriction_unique i ((e : MulAut (ι → S)) * (f : MulAut (ι → S)))
    · exact Classical.choose_spec (e * f).property
    · intro s
      change (e : MulAut (ι → S)) ((f : MulAut (ι → S)) (singleFactor i s)) =
        singleFactor i (Classical.choose e.property (Classical.choose f.property s))
      rw [Classical.choose_spec f.property s, Classical.choose_spec e.property]

theorem factorRestriction_eq (i : ι) (e : factorStabilizer (S := S) i) (a : MulAut S)
    (ha : ∀ s, (e : MulAut (ι → S)) (singleFactor i s) = singleFactor i (a s)) :
    factorRestriction i e = a :=
  restriction_unique i e _ _ (Classical.choose_spec e.property) ha

private theorem conj_injective_of_center_eq_bot (hCenter : Subgroup.center S = ⊥) :
    Function.Injective (MulAut.conj (G := S)) := by
  apply (MonoidHom.ker_eq_bot_iff (f := MulAut.conj (G := S))).mp
  apply le_antisymm _ bot_le
  intro s hs
  have hh := MonoidHom.mem_ker.mp hs
  rw [← hCenter, Subgroup.mem_center_iff]
  intro t
  have he : s * t * s⁻¹ = t := DFunLike.congr_fun hh t
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

/-- The factor-restriction image of a subgroup contains the order of
    the simple factor when it contains every inner automorphism. -/
theorem primeSpectrum_le_of_full_inner_restriction (hCenter : Subgroup.center S = ⊥)
    (i : ι) (H : Subgroup (MulAut (ι → S)))
    (hInner : (MulAut.conj (G := S)).range ≤
      ((factorRestriction i).comp
        (Subgroup.inclusion (show H ⊓ factorStabilizer i ≤ factorStabilizer i from inf_le_right))).range) :
    primeSpectrum S ⊆ primeSpectrum H := by
  let K := H ⊓ factorStabilizer i
  let f : K →* MulAut S := (factorRestriction i).comp (Subgroup.inclusion inf_le_right)
  let g : S →* f.range := Subgroup.inclusion hInner |>.comp (MulAut.conj (G := S)).rangeRestrict
  apply (primeSpectrum_mono_of_injective g ?_).trans
  · exact (primeSpectrum_mono_of_surjective f.rangeRestrict f.rangeRestrict_surjective).trans
      (primeSpectrum_mono_of_injective (Subgroup.inclusion inf_le_left)
        (Subgroup.inclusion_injective (show K ≤ H from inf_le_left)))
  · exact (Subgroup.inclusion_injective hInner).comp
      (MonoidHom.rangeRestrict_injective_iff.mpr (conj_injective_of_center_eq_bot hCenter))

/-- Two closed walks supply the factor prime spectrum as soon as
    their restrictions generate a group containing the inner automorphisms. -/
theorem primeSpectrum_le_of_two_closed_walks (hCenter : Subgroup.center S = ⊥)
    (i : ι) (x y : MulAut (ι → S))
    (s t : List (Equiv.Perm ι × (ι → MulAut S)))
    (hs : trailPermutation s i = i) (ht : trailPermutation t i = i)
    (hsMem : pathLabel (s.map (fun e => factorAction e.1 e.2)) ∈ Subgroup.closure {x, y})
    (htMem : pathLabel (t.map (fun e => factorAction e.1 e.2)) ∈ Subgroup.closure {x, y})
    (hGen : (MulAut.conj (G := S)).range ≤ Subgroup.closure {trailLabel s i, trailLabel t i}) :
    primeSpectrum S ⊆ primeSpectrum (Subgroup.closure {x, y}) := by
  let H := Subgroup.closure {x, y}
  let K := H ⊓ factorStabilizer i
  let f : K →* MulAut S := (factorRestriction i).comp (Subgroup.inclusion inf_le_right)
  have hInRange (r : List (Equiv.Perm ι × (ι → MulAut S)))
      (hr : trailPermutation r i = i)
      (hMem : pathLabel (r.map (fun e => factorAction e.1 e.2)) ∈ H) :
      trailLabel r i ∈ f.range := by
    let word := pathLabel (r.map (fun e => factorAction e.1 e.2))
    have hAct : ∀ a : S, word (singleFactor i a) = singleFactor i (trailLabel r i a) :=
      trail_restricts_to_factor r i hr
    let q : K := ⟨word, ⟨hMem, ⟨_, hAct⟩⟩⟩
    refine ⟨q, ?_⟩
    exact factorRestriction_eq i ⟨word, ⟨_, hAct⟩⟩ _ hAct
  apply primeSpectrum_le_of_full_inner_restriction hCenter i H
  refine hGen.trans ((Subgroup.closure_le f.range).mpr ?_)
  intro a ha
  rcases Set.mem_insert_iff.mp ha with rfl | ha
  · exact hInRange s hs hsMem
  · obtain rfl := Set.mem_singleton_iff.mp ha
    exact hInRange t ht htMem

end Shumyatsky
