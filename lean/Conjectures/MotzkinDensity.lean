import Conjectures.MotzkinFiniteTheorem
import Conjectures.MotzkinCharacterLower
import Mathlib.Topology.Algebra.ContinuousMonoidHom

/-! Actual measurable-set suprema and continuous-character suprema. The
character lower bound is general; the equality here is the complete finite case. -/
namespace Motzkin

open MeasureTheory MeasureTheory.Measure

variable {G : Type*} [AddCommGroup G] [MeasurableSpace G]

noncomputable def density (μ : Measure G) (a b : G) : ℝ :=
  sSup {ρ : ℝ | ∃ A : Set G, MeasurableSet A ∧ Avoids A a b ∧ ρ=μ.real A}

theorem density_candidates_nonempty (μ : Measure G) (a b : G) :
    {ρ : ℝ | ∃ A : Set G, MeasurableSet A ∧ Avoids A a b ∧ ρ=μ.real A}.Nonempty := by
  refine ⟨μ.real ∅,∅,MeasurableSet.empty,?_,rfl⟩
  intro x hx
  exact hx.elim

theorem density_candidates_bounded (μ : Measure G) [IsProbabilityMeasure μ] (a b : G) :
    BddAbove {ρ : ℝ | ∃ A : Set G, MeasurableSet A ∧ Avoids A a b ∧ ρ=μ.real A} := by
  refine ⟨1,?_⟩
  rintro ρ ⟨A,_,_,rfl⟩
  exact measureReal_le_one

theorem le_density (μ : Measure G) [IsProbabilityMeasure μ] {a b : G} {A : Set G}
    (hA : MeasurableSet A) (havoid : Avoids A a b) : μ.real A ≤ density μ a b :=
  le_csSup (density_candidates_bounded μ a b) ⟨A,hA,havoid,rfl⟩

theorem density_le (μ : Measure G) {a b : G} {r : ℝ}
    (h : ∀ A : Set G, MeasurableSet A → Avoids A a b → μ.real A ≤ r) : density μ a b ≤ r := by
  apply csSup_le (density_candidates_nonempty μ a b)
  rintro ρ ⟨A,hA,havoid,rfl⟩
  exact h A hA havoid

theorem density_le_half [MeasurableAdd G] (μ : Measure G) [IsProbabilityMeasure μ]
    [IsAddLeftInvariant μ] (a b : G) : density μ a b ≤ 1/2 := by
  apply density_le μ
  intro A hA havoid
  exact avoiding_measure_le_half μ hA (fun x hx => (havoid x hx).1)

section ContinuousCharacters

variable [TopologicalSpace G]

noncomputable def characterValue (a b : G) : ℝ :=
  sSup (Set.range (fun χ : ContinuousAddMonoidHom G UnitAddCircle => min ‖χ a‖ ‖χ b‖))

omit [MeasurableSpace G] in
theorem character_candidates_nonempty (a b : G) :
    (Set.range (fun χ : ContinuousAddMonoidHom G UnitAddCircle => min ‖χ a‖ ‖χ b‖)).Nonempty :=
  Set.range_nonempty _

omit [MeasurableSpace G] in
theorem character_candidates_bounded (a b : G) :
    BddAbove (Set.range (fun χ : ContinuousAddMonoidHom G UnitAddCircle => min ‖χ a‖ ‖χ b‖)) := by
  refine ⟨1/2,?_⟩
  rintro r ⟨χ,rfl⟩
  have hh := AddCircle.norm_le_half_period (1:ℝ) (x:=χ a) (by norm_num)
  norm_num only [abs_one] at hh
  exact (min_le_left _ _).trans hh

omit [MeasurableSpace G] in
theorem le_characterValue (a b : G) (χ : ContinuousAddMonoidHom G UnitAddCircle) :
    min ‖χ a‖ ‖χ b‖ ≤ characterValue a b :=
  le_csSup (character_candidates_bounded a b) ⟨χ,rfl⟩

theorem characterValue_le_density [BorelSpace G] (μ : Measure G) [IsProbabilityMeasure μ]
    (a b : G) : characterValue a b ≤ density μ a b := by
  apply csSup_le (character_candidates_nonempty a b)
  rintro r ⟨χ,rfl⟩
  obtain ⟨A,hA,havoid,hr⟩ := character_lower_bound μ χ.toAddMonoidHom χ.continuous.measurable a b
  exact hr.trans (le_density μ hA havoid)

theorem finite_measure_le_characterValue [Fintype G] [DiscreteTopology G] [BorelSpace G]
    [MeasurableAdd G] (μ : Measure G) [IsProbabilityMeasure μ] [IsAddLeftInvariant μ]
    (a b : G) (hgen : AddSubgroup.closure ({a,b} : Set G)=⊤)
    {A : Set G} (hA : MeasurableSet A) (havoid : Avoids A a b) :
    μ.real A ≤ characterValue a b := by
  classical
  obtain ⟨t,ht⟩ := exists_translatedCount_ge μ hA (Finset.univ : Finset G)
  let B : Finset G := Finset.univ.filter (fun x => x+t ∈ A)
  have hB : ∀ x ∈ B, x+a ∉ B ∧ x+b ∉ B := by
    intro x hx
    have hxA := (Finset.mem_filter.mp hx).2
    constructor
    · intro hxa
      have hh := (Finset.mem_filter.mp hxa).2
      apply (havoid (x+t) hxA).1
      simpa only [add_assoc,add_comm,add_left_comm] using hh
    · intro hxb
      have hh := (Finset.mem_filter.mp hxb).2
      apply (havoid (x+t) hxA).2
      simpa only [add_assoc,add_comm,add_left_comm] using hh
  have hρ : μ.real A ≤ (B.card:ℝ)/(Fintype.card G:ℝ) := by
    have hN : (0:ℝ) < Fintype.card G := by exact_mod_cast Fintype.card_pos
    apply (le_div_iff₀ hN).mpr
    change ((Finset.univ : Finset G).card:ℝ)*μ.real A ≤ (B.card:ℝ) at ht
    rw [Finset.card_univ] at ht
    nlinarith only [ht]
  obtain ⟨χ,hχ⟩ := finite_independent_character a b hgen B hB
  let ψ : ContinuousAddMonoidHom G UnitAddCircle :=
    {toAddMonoidHom := χ,continuous_toFun := continuous_of_discreteTopology}
  exact hρ.trans (hχ.trans (le_characterValue a b ψ))

/-- Full Motzkin equality for finite Hausdorff abelian groups generated by
the two differences, at the actual measure and continuous-character suprema. -/
theorem finite_density_eq_characterValue [Fintype G] [DiscreteTopology G] [BorelSpace G]
    [MeasurableAdd G] (μ : Measure G) [IsProbabilityMeasure μ] [IsAddLeftInvariant μ]
    (a b : G) (hgen : AddSubgroup.closure ({a,b} : Set G)=⊤) :
    density μ a b=characterValue a b := by
  apply le_antisymm
  · apply density_le μ
    intro A hA havoid
    exact finite_measure_le_characterValue μ a b hgen hA havoid
  · exact characterValue_le_density μ a b

end ContinuousCharacters
end Motzkin
