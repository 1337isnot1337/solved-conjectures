module

public import Conjectures.ShumyatskyCycleLabels
public import Conjectures.ShumyatskyFactorAction

/-! Evaluate traversed edges and their labels on the actual product group. -/

@[expose] public section

namespace Shumyatsky

variable {ι S : Type*} [Group S]

theorem factorAction_one :
    factorAction (1 : Equiv.Perm ι) (fun _ => (1 : MulAut S)) = 1 := by
  apply MulEquiv.ext
  intro v
  funext i
  rfl

/-- A reversed edge uses the inverse of the label at its new destination. -/
theorem factorAction_inv (σ : Equiv.Perm ι) (a : ι → MulAut S) :
    (factorAction σ a)⁻¹ = factorAction σ⁻¹ (fun i => (a (σ.symm i))⁻¹) := by
  apply inv_eq_of_mul_eq_one_right
  rw [factorAction_mul, mul_inv_cancel]
  change factorAction 1 (fun i => a (σ.symm i) * (a (σ.symm i))⁻¹) = 1
  simp_rw [mul_inv_cancel]
  exact factorAction_one

/-- The permutations of the steps compose in their traversal order. -/
def trailPermutation (steps : List (Equiv.Perm ι × (ι → MulAut S))) : Equiv.Perm ι :=
  pathLabel (steps.map Prod.fst)

/-- Read a step's label at its starting factor before visiting the next factor. -/
def trailLabel : List (Equiv.Perm ι × (ι → MulAut S)) → ι → MulAut S
  | [], _ => 1
  | (σ, a) :: rest, i => trailLabel rest (σ i) * a i

theorem trail_factorAction (steps : List (Equiv.Perm ι × (ι → MulAut S))) :
    pathLabel (steps.map (fun e => factorAction e.1 e.2)) =
      factorAction (trailPermutation steps) (trailLabel steps) := by
  induction steps with
  | nil =>
    exact factorAction_one.symm
  | cons step rest ih =>
    rcases step with ⟨σ, a⟩
    change pathLabel (rest.map (fun e => factorAction e.1 e.2)) * factorAction σ a =
      factorAction (trailPermutation rest * σ) (fun i => trailLabel rest (σ i) * a i)
    rw [ih, factorAction_mul]

/-- A closed walk based at a factor acts on that actual factor by the
    product of the successive labels along the walk. -/
theorem trail_restricts_to_factor [DecidableEq ι]
    (steps : List (Equiv.Perm ι × (ι → MulAut S))) (i : ι) (hClosed : trailPermutation steps i = i)
    (s : S) :
    pathLabel (steps.map (fun e => factorAction e.1 e.2)) (Pi.mulSingle i s) =
      Pi.mulSingle i (trailLabel steps i s) := by
  rw [trail_factorAction, factorAction_mulSingle, hClosed]

/-- If each step is a generator or its inverse, its word lies in the
    subgroup generated by the two actual product automorphisms. -/
theorem trail_mem_pair_closure (steps : List (Equiv.Perm ι × (ι → MulAut S)))
    (x y : MulAut (ι → S))
    (hSteps : ∀ e ∈ steps, factorAction e.1 e.2 = x ∨ factorAction e.1 e.2 = x⁻¹ ∨
      factorAction e.1 e.2 = y ∨ factorAction e.1 e.2 = y⁻¹) :
    pathLabel (steps.map (fun e => factorAction e.1 e.2)) ∈ Subgroup.closure {x, y} := by
  let H : Subgroup (MulAut (ι → S)) := Subgroup.closure {x, y}
  have hx : x ∈ H := Subgroup.subset_closure (by simp)
  have hy : y ∈ H := Subgroup.subset_closure (by simp)
  induction steps with
  | nil => exact H.one_mem
  | cons step rest ih =>
    refine H.mul_mem (ih fun e he => hSteps e (List.mem_cons_of_mem step he)) ?_
    change factorAction step.1 step.2 ∈ H
    rcases hSteps step (by simp) with h | h | h | h
    · exact h.symm ▸ hx
    · exact h.symm ▸ H.inv_mem hx
    · exact h.symm ▸ hy
    · exact h.symm ▸ H.inv_mem hy

theorem trailLabel_append (first second : List (Equiv.Perm ι × (ι → MulAut S)))
    (i : ι) :
    trailLabel (first ++ second) i =
      trailLabel second (trailPermutation first i) * trailLabel first i := by
  induction first generalizing i with
  | nil =>
    change trailLabel second i = trailLabel second i * 1
    rw [mul_one]
  | cons edge rest ih =>
    rcases edge with ⟨σ, a⟩
    change trailLabel (rest ++ second) (σ i) * a i =
      trailLabel second (trailPermutation rest (σ i)) * (trailLabel rest (σ i) * a i)
    rw [ih, mul_assoc]

/-- The product at a selected occurrence has fixed left and right
    transport factors from the other steps. -/
theorem trailLabel_selected_edge (first second : List (Equiv.Perm ι × (ι → MulAut S)))
    (σ : Equiv.Perm ι) (a : ι → MulAut S) (i : ι) :
    trailLabel (first ++ (σ, a) :: second) i =
      trailLabel second (σ (trailPermutation first i)) *
        a (trailPermutation first i) * trailLabel first i := by
  rw [trailLabel_append]
  rfl

/-- At a selected occurrence, fixed transports send its prescribed
    outer class bijectively onto the corresponding class of word labels. -/
theorem existsUnique_edge_label_for_word (left right reference target : MulAut S)
    (hOuter : outerProjection target = outerProjection (left * reference * right)) :
    ∃! e : MulAut S, outerProjection e = outerProjection reference ∧
      left * e * right = target := by
  have hUnique (e : MulAut S) :
      left * e * right = target ↔ e = left⁻¹ * target * right⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq, eq_inv_mul_iff_mul_eq]
    rw [mul_assoc]
  refine ⟨left⁻¹ * target * right⁻¹, ⟨?_, (hUnique _).2 rfl⟩, ?_⟩
  · simp only [map_mul, map_inv] at hOuter ⊢
    rw [hOuter]
    simp [← mul_assoc]
  · intro e he
    exact (hUnique _).1 he.2

end Shumyatsky
