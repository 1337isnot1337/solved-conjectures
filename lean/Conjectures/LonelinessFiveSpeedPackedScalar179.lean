set_option maxRecDepth 20000
set_option maxHeartbeats 0
set_option Elab.async false

namespace Loneliness.FiveSpeedCertificate.PackedScalars.P179

/-! A literal packed oracle. Its finite equality certificate is checked
against the existing scalar tree, including the zero block. -/

noncomputable def packed : ℕ := nat_lit 

noncomputable def mask : ℕ → ℕ := packedScalarMask 179 packed

theorem checked :
    packedScalarTreeCheck 179 packed ScalarTrees.P179.tree = true := by
  decide +kernel

theorem mask_eq_treeMask :
    mask = treeMask 179 ScalarTrees.P179.tree :=
  packedScalarMask_eq_treeMask_function 179 packed ScalarTrees.P179.tree checked

theorem sound (a : ℕ) : GoodMask 179 a (mask a) :=
  packedScalarTreeCheck_sound 179 packed ScalarTrees.P179.tree
    ScalarTrees.P179.checked checked a

end Loneliness.FiveSpeedCertificate.PackedScalars.P179
