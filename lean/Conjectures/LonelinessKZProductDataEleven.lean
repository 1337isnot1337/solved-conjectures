noncomputable def row (m : Fin (2^10)) : DualRow := rowData.get m.val

private theorem rows_valid_block_0 : ∀ j : Fin 64,
    DualValid 10 bounds (fun i => (0*64+j.val).testBit i.val)
      (row ⟨0*64+j.val, by omega⟩) := by decide +kernel

