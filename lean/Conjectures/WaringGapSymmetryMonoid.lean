def transfer_double_gap (S T : Nat → Prop) (he : ∀ n, S n ↔ T n)
    (w : DoubleGapWitness T) : DoubleGapWitness S where
  F := w.F
  t := w.t
  above := fun n hn => (he n).mpr (w.above n hn)
  F_gap := fun h => w.F_gap ((he w.F).mp h)
  t_lt := w.t_lt
  t_gap := fun h => w.t_gap ((he w.t).mp h)
  other_gap := fun h => w.other_gap ((he (w.F-w.t)).mp h)

def generatedWitness64 : DoubleGapWitness (Generated 64) :=
  transfer_double_gap _ _ exact_monoid64 fourWitness64

def generatedWitness128 : DoubleGapWitness (Generated 128) :=
  transfer_double_gap _ _ exact_monoid128 fourWitness128

