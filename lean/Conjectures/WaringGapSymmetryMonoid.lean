module

public import Conjectures.WaringGapSymmetryLift

@[expose] public section

namespace WaringGapSymmetryCore

/-- The additive submonoid generated by all positive-power offsets m^e-1.
The generator for m=1 is zero, so allowing it does not change the monoid. -/
inductive Generated (e : Nat) : Nat → Prop
  | zero : Generated e 0
  | step {n m : Nat} : Generated e n → 0<m → Generated e (n+(m^e-1))

theorem generated_add (e : Nat) {a b : Nat}
    (ha : Generated e a) (hb : Generated e b) : Generated e (a+b) := by
  induction hb with
  | zero => simpa using ha
  | step hn hm ih =>
    rw [← Nat.add_assoc]
    exact Generated.step ih hm

theorem generated_mul (e : Nat) {a : Nat} (ha : Generated e a)
    (k : Nat) : Generated e (k*a) := by
  induction k with
  | zero => simpa using Generated.zero (e:=e)
  | succ k ih =>
    rw [Nat.succ_mul]
    exact generated_add e ih ha

theorem generated_generator (e m : Nat) (hm : 0<m) :
    Generated e (m^e-1) := by
  have h := Generated.step (e:=e) (m:=m) Generated.zero hm
  simpa using h

theorem generated_iff_four (e : Nat) (d : ReductionData) (D : Nat)
    (hx : 17*d.x=2^e-1) (hy : 17*d.y=3^e-1)
    (hz : 17*d.z=5^e-1) (hD : D=17^e-1)
    (hgen : ∀ m, 0<m → FourGen d D (m^e-1)) (n : Nat) :
    Generated e n ↔ FourGen d D n := by
  constructor
  · intro h
    induction h with
    | zero => exact four_zero d D
    | step hn hm ih =>
      exact four_add d D ih (hgen _ hm)
  · intro h
    obtain ⟨l,t,⟨i,j,k,ht⟩,he⟩ := h
    have hgD : Generated e D := by
      rw [hD]
      exact generated_generator e 17 (by decide)
    have hgx : Generated e (17*d.x) := by
      rw [hx]
      exact generated_generator e 2 (by decide)
    have hgy : Generated e (17*d.y) := by
      rw [hy]
      exact generated_generator e 3 (by decide)
    have hgz : Generated e (17*d.z) := by
      rw [hz]
      exact generated_generator e 5 (by decide)
    have hn : n=l*D+(i*(17*d.y)+j*(17*d.z)+k*(17*d.x)) := by
      rw [he,ht]
      unfold weight
      rw [Nat.mul_add,Nat.mul_add,Nat.mul_left_comm 17 i d.y,
        Nat.mul_left_comm 17 j d.z,Nat.mul_comm d.x k,Nat.mul_left_comm 17 k d.x]
    rw [hn]
    exact generated_add e (generated_mul e hgD l)
      (generated_add e (generated_add e (generated_mul e hgy i)
        (generated_mul e hgz j)) (generated_mul e hgx k))

theorem all_generators64 (m : Nat) (hm : 0<m) :
    FourGen data64 D64 (m^64-1) := by
  by_cases hbig : 19≤m
  · have hp : 19^64≤m^64 := Nat.pow_le_pow_left hbig 64
    have hc : fourWitness64.F<19^64-1 := by decide
    exact fourWitness64.above _ (Nat.lt_of_lt_of_le hc (Nat.sub_le_sub_right hp 1))
  · have hs : m=1 ∨ m=2 ∨ m=3 ∨ m=4 ∨ m=5 ∨ m=6 ∨ m=7 ∨ m=8 ∨ m=9 ∨ m=10 ∨ m=11 ∨ m=12 ∨ m=13 ∨ m=14 ∨ m=15 ∨ m=16 ∨ m=17 ∨ m=18 := by omega
    rcases hs with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
    · exact four_zero data64 D64
    · exact ⟨0,(2^64-1)/17,⟨0,0,1,by decide⟩,by decide⟩
    · exact ⟨0,(3^64-1)/17,⟨1,0,0,by decide⟩,by decide⟩
    · exact ⟨0,(4^64-1)/17,⟨0,0,18446744073709551617,by decide⟩,by decide⟩
    · exact ⟨0,(5^64-1)/17,⟨0,1,0,by decide⟩,by decide⟩
    · exact ⟨0,(6^64-1)/17,⟨18446744073709551616,0,1,by decide⟩,by decide⟩
    · exact ⟨0,(7^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact ⟨0,(8^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact ⟨0,(9^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact ⟨0,(10^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact ⟨0,(11^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact ⟨0,(12^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact ⟨0,(13^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact ⟨0,(14^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact ⟨0,(15^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact ⟨0,(16^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩
    · exact four_D data64 D64
    · exact ⟨0,(18^64-1)/17,above_bound data64 cover64 _ (by decide),by decide⟩

theorem exact_monoid64 (n : Nat) :
    Generated 64 n ↔ FourGen data64 D64 n :=
  generated_iff_four 64 data64 D64
    (by decide) (by decide) (by decide) rfl all_generators64 n

