import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Algebra.Group.Subgroup.Defs
import Mathlib.Algebra.Ring.Parity
import Mathlib.Data.Fintype.Pi
import Mathlib.Data.Int.Interval
import Mathlib.Tactic

/-! An integral parity lattice with arbitrarily many initial spherical
2-design shells and a subsequent shell with unequal diagonal moments. -/

open Finset
open scoped BigOperators

namespace CoulangeonLazzariniShells

/-- Squared Euclidean norm of an integral vector. -/
def normSq {n : ℕ} (x : Fin n → ℤ) : ℤ := ∑ i, (x i) ^ 2

theorem normSq_nonneg {n : ℕ} (x : Fin n → ℤ) : 0 ≤ normSq x :=
  sum_nonneg fun i _ => sq_nonneg (x i)

theorem sq_le_normSq {n : ℕ} (x : Fin n → ℤ) (i : Fin n) : (x i) ^ 2 ≤ normSq x :=
  single_le_sum (fun j _ => sq_nonneg (x j)) (mem_univ i)

private def allEven {n : ℕ} (x : Fin n → ℤ) : Prop := ∀ i, Even (x i)

private def oddTail {n : ℕ} (x : Fin (n + 1) → ℤ) : Prop :=
  Even (x 0) ∧ ∀ i : Fin n, Odd (x i.succ)

/-- The preimage of the code generated by the word with one zero and `n` ones. -/
def lattice (n : ℕ) : AddSubgroup (Fin (n + 1) → ℤ) where
  carrier := {x | allEven x ∨ oddTail x}
  zero_mem' := Or.inl (fun _ => Even.zero)
  add_mem' := by
    intro x y hx hy
    rcases hx with hx | hx <;> rcases hy with hy | hy
    · exact Or.inl (fun i => (hx i).add (hy i))
    · exact Or.inr ⟨(hx 0).add hy.1, fun i => (hx i.succ).add_odd (hy.2 i)⟩
    · exact Or.inr ⟨hx.1.add (hy 0), fun i => (hx.2 i).add_even (hy i.succ)⟩
    · refine Or.inl (fun i => Fin.cases ?_ (fun j => ?_) i)
      · exact hx.1.add hy.1
      · exact (hx.2 j).add_odd (hy.2 j)
  neg_mem' := by
    intro x hx
    rcases hx with hx | hx
    · exact Or.inl (fun i => (hx i).neg)
    · exact Or.inr ⟨hx.1.neg, fun i => (hx.2 i).neg⟩

@[simp] theorem mem_lattice {n : ℕ} {x : Fin (n + 1) → ℤ} :
    x ∈ lattice n ↔ allEven x ∨ oddTail x := Iff.rfl

theorem doubled_vec_mem {n : ℕ} (x : Fin (n + 1) → ℤ) :
    (fun i => 2 * x i) ∈ lattice n :=
  Or.inl (fun i => ⟨x i, by ring⟩)

private theorem odd_square_lower {z : ℤ} (hz : Odd z) : 1 ≤ z ^ 2 := by
  have hn : z ≠ 0 := by
    obtain ⟨w, heq⟩ := hz
    omega
  by_cases h : 0 < z
  · nlinarith [mul_nonneg (show 0 ≤ z - 1 by omega) (show 0 ≤ z + 1 by omega)]
  · nlinarith [mul_nonneg (show 0 ≤ -z - 1 by omega) (show 0 ≤ -z + 1 by omega)]

theorem oddTail_lower {n : ℕ} {x : Fin (n + 1) → ℤ} (hx : oddTail x) :
    (x 0) ^ 2 + (n : ℤ) ≤ normSq x := by
  unfold normSq
  rw [Fin.sum_univ_succ]
  have h : (n : ℤ) ≤ ∑ i : Fin n, (x i.succ) ^ 2 := by
    simpa using (sum_le_sum (s := univ) (f := fun _ : Fin n => (1 : ℤ))
      (g := fun i => (x i.succ) ^ 2) (fun i _ => odd_square_lower (hx.2 i)))
  linarith

theorem allEven_norm_multiple_four {n : ℕ} {x : Fin n → ℤ} (hx : allEven x) :
    (4 : ℤ) ∣ normSq x := by
  unfold normSq
  apply dvd_sum
  intro i _
  obtain ⟨u, hu⟩ := hx i
  exact ⟨u ^ 2, by rw [hu]; ring⟩

/-- A concrete finite set for each shell, with bounds proved from the norm. -/
noncomputable def shell (n : ℕ) (r : ℤ) : Finset (Fin (n + 1) → ℤ) := by
  classical
  exact (Fintype.piFinset fun _ : Fin (n + 1) => Icc (-r) r).filter
    (fun x => x ∈ lattice n ∧ normSq x = r)

private theorem integer_abs_le_sq (z : ℤ) : |z| ≤ z ^ 2 := by
  by_cases h : 0 ≤ z
  · rw [abs_of_nonneg h]
    by_cases hz : z = 0
    · simp [hz]
    · nlinarith [mul_nonneg h (show 0 ≤ z - 1 by omega)]
  · rw [abs_of_neg (by omega)]
    nlinarith [mul_nonneg (show 0 ≤ -z by omega) (show 0 ≤ -z - 1 by omega)]

theorem mem_shell {n : ℕ} {r : ℤ} {x : Fin (n + 1) → ℤ} :
    x ∈ shell n r ↔ x ∈ lattice n ∧ normSq x = r := by
  classical
  rw [shell, mem_filter]
  refine ⟨And.right, fun h => ⟨?_, h⟩⟩
  apply Fintype.mem_piFinset.2
  intro i
  exact mem_Icc.2 (abs_le.1 ((integer_abs_le_sq (x i)).trans ((sq_le_normSq x i).trans_eq h.2)))

theorem shell_allEven {n : ℕ} {r : ℤ} (hr : r < n) {x : Fin (n + 1) → ℤ} :
    x ∈ shell n r ↔ allEven x ∧ normSq x = r := by
  rw [mem_shell, mem_lattice]
  constructor
  · rintro ⟨he | ho, hnorm⟩
    · exact ⟨he, hnorm⟩
    · have hl := oddTail_lower ho
      linarith [sq_nonneg (x 0)]
  · rintro ⟨he, hnorm⟩
    exact ⟨Or.inl he, hnorm⟩

/-- The quadratic moment criterion for a spherical 2-design. The factors of
`n` keep the reference sphere moments in exact integer arithmetic. -/
def IsDesign2 {n : ℕ} (S : Finset (Fin n → ℤ)) (r : ℤ) : Prop :=
  S.Nonempty ∧ (∀ x ∈ S, normSq x = r) ∧
  (∀ i, ∑ x ∈ S, x i = 0) ∧
  (∀ i j, i ≠ j → ∑ x ∈ S, x i * x j = 0) ∧
  (∀ i, (n : ℤ) * (∑ x ∈ S, (x i) ^ 2) = (S.card : ℤ) * r)

private def flip {n : ℕ} (i : Fin n) (x : Fin n → ℤ) : Fin n → ℤ :=
  fun j => if j = i then -x j else x j

private def flipEquiv {n : ℕ} (i : Fin n) : (Fin n → ℤ) ≃ (Fin n → ℤ) :=
  Function.Involutive.toPerm (f := flip i) (by
    intro x
    funext j
    by_cases h : j = i <;> simp [flip, h])

private theorem flip_mem_iff {n : ℕ} {r : ℤ} (hr : r < n)
    (i : Fin (n + 1)) (x : Fin (n + 1) → ℤ) :
    flipEquiv i x ∈ shell n r ↔ x ∈ shell n r := by
  rw [shell_allEven hr, shell_allEven hr]
  change (allEven (flip i x) ∧ normSq (flip i x) = r) ↔ _
  have hnorm : normSq (flip i x) = normSq x := by
    apply sum_congr rfl
    intro j _
    by_cases h : j = i <;> simp [flip, h]
  have heven : allEven (flip i x) ↔ allEven x := by
    unfold allEven
    simp only [flip]
    constructor <;> intro h j <;> specialize h j <;> by_cases hj : j = i <;> simpa [hj] using h
  rw [hnorm, heven]

private def permute {n : ℕ} (p : Equiv.Perm (Fin n)) : (Fin n → ℤ) ≃ (Fin n → ℤ) where
  toFun x := x ∘ p
  invFun x := x ∘ p.symm
  left_inv := by intro x; funext i; simp
  right_inv := by intro x; funext i; simp

private theorem permute_mem_iff {n : ℕ} {r : ℤ} (hr : r < n)
    (p : Equiv.Perm (Fin (n + 1))) (x : Fin (n + 1) → ℤ) :
    permute p x ∈ shell n r ↔ x ∈ shell n r := by
  rw [shell_allEven hr, shell_allEven hr]
  change (allEven (x ∘ p) ∧ normSq (x ∘ p) = r) ↔ _
  have hnorm : normSq (x ∘ p) = normSq x := by
    exact Equiv.sum_comp p (fun i => (x i) ^ 2)
  have heven : allEven (x ∘ p) ↔ allEven x := by
    constructor
    · intro h i
      simpa using h (p.symm i)
    · intro h i
      exact h (p i)
  rw [hnorm, heven]

private theorem sum_symmetry {α : Type*} (S : Finset α) (p : α ≃ α)
    (hp : ∀ x, p x ∈ S ↔ x ∈ S) (f : α → ℤ) :
    (∑ x ∈ S, f (p x)) = ∑ x ∈ S, f x := by
  classical
  apply sum_bij (fun x _ => p x)
  · exact fun x hx => (hp x).2 hx
  · exact fun x _ y _ h => p.injective h
  · exact fun y hy => ⟨p.symm y, (hp (p.symm y)).1 (by simpa using hy), by simp⟩
  · exact fun _ _ => rfl

theorem cubic_shell_design {n : ℕ} {r : ℤ} (hr : r < n)
    (hne : (shell n r).Nonempty) : IsDesign2 (shell n r) r := by
  refine ⟨hne, fun _ hx => (mem_shell.1 hx).2, ?_, ?_, ?_⟩
  · intro i
    have h := sum_symmetry (shell n r) (flipEquiv i) (flip_mem_iff hr i) (fun x => x i)
    change (∑ x ∈ shell n r, flip i x i) = _ at h
    simp only [flip, ite_true, sum_neg_distrib] at h
    omega
  · intro i j hij
    have h := sum_symmetry (shell n r) (flipEquiv i) (flip_mem_iff hr i)
      (fun x => x i * x j)
    change (∑ x ∈ shell n r, flip i x i * flip i x j) = _ at h
    simp only [flip, ite_true, Ne.symm hij, ite_false, neg_mul, sum_neg_distrib] at h
    omega
  · intro i
    have hdiag (j : Fin (n + 1)) :
        (∑ x ∈ shell n r, (x j) ^ 2) = ∑ x ∈ shell n r, (x i) ^ 2 := by
      have h := sum_symmetry (shell n r) (permute (Equiv.swap i j))
        (permute_mem_iff hr _) (fun x => (x i) ^ 2)
      change (∑ x ∈ shell n r, (x (Equiv.swap i j i)) ^ 2) = _ at h
      simpa using h
    have htrace : (∑ j : Fin (n + 1), ∑ x ∈ shell n r, (x j) ^ 2) =
        ((shell n r).card : ℤ) * r := by
      rw [sum_comm]
      have hterms : ∀ x ∈ shell n r, (∑ j : Fin (n + 1), (x j) ^ 2) = r :=
        fun _ hx => (mem_shell.1 hx).2
      rw [sum_congr rfl hterms]
      simp
    simpa [hdiag, nsmul_eq_mul] using htrace


private def evenWitness (n j : ℕ) (i : Fin (n + 1)) : ℤ :=
  if i.val < j then 2 else 0

private theorem evenWitness_norm (n j : ℕ) (hj : j ≤ n + 1) :
    normSq (evenWitness n j) = 4 * (j : ℤ) := by
  have hterms (i : Fin (n + 1)) :
      (evenWitness n j i) ^ 2 = if i.val < j then (4 : ℤ) else 0 := by
    by_cases hi : i.val < j <;> norm_num [evenWitness, hi]
  have hfilter : ((range (n + 1)).filter fun i => i < j) = range j := by
    ext i
    simp only [mem_filter, mem_range]
    omega
  unfold normSq
  simp_rw [hterms]
  rw [Fin.sum_univ_eq_sum_range (fun i => if i < j then (4 : ℤ) else 0), ← sum_filter, hfilter]
  simp [mul_comm]

private theorem evenShell_nonempty (n j : ℕ) (hj : j ≤ n + 1) :
    (shell n (4 * (j : ℤ))).Nonempty := by
  refine ⟨evenWitness n j, mem_shell.2 ⟨Or.inl ?_, evenWitness_norm n j hj⟩⟩
  intro i
  by_cases hi : i.val < j
  · simp [evenWitness, hi]
  · simp [evenWitness, hi]

/-- Precisely the positive squared norms attained below the first odd shell. -/
theorem norms_before_bad_shell (k : ℕ) {r : ℤ} (hr0 : 0 < r) (hr : r < 4 * (k : ℤ) + 1) :
    (shell (4 * k + 1) r).Nonempty ↔ ∃ j : ℕ, 1 ≤ j ∧ j ≤ k ∧ r = 4 * (j : ℤ) := by
  constructor
  · rintro ⟨x, hx⟩
    have hn : r < ((4 * k + 1 : ℕ) : ℤ) := by push_cast; exact hr
    obtain ⟨he, hnorm⟩ := (shell_allEven hn).1 hx
    obtain ⟨j, hj⟩ := allEven_norm_multiple_four he
    have hjpos : 0 < j := by omega
    have hcast : (j.toNat : ℤ) = j := Int.toNat_of_nonneg hjpos.le
    exact ⟨j.toNat, by omega, by omega, by omega⟩
  · rintro ⟨j, _, hj, rfl⟩
    exact evenShell_nonempty _ _ (by omega)

private def oddWitness (n : ℕ) (i : Fin (n + 1)) : ℤ := if i = 0 then 0 else 1

private theorem oddWitness_norm (n : ℕ) : normSq (oddWitness n) = n := by
  rw [normSq, Fin.sum_univ_succ]
  simp [oddWitness, Fin.succ_ne_zero]

theorem bad_shell_nonempty (k : ℕ) : (shell (4 * k + 1) (4 * (k : ℤ) + 1)).Nonempty := by
  refine ⟨oddWitness (4 * k + 1), mem_shell.2 ⟨Or.inr ?_, ?_⟩⟩
  · constructor
    · simp [oddWitness]
    · intro i
      simp [oddWitness, Fin.succ_ne_zero]
  · rw [oddWitness_norm]
    push_cast
    ring

/-- The failing shell is precisely the signed unit vectors on the (4k+1) odd coordinates,
all with zero in the first coordinate. -/
theorem bad_shell_shape (k : ℕ) {x : Fin ((4 * k + 1) + 1) → ℤ} :
    x ∈ shell (4 * k + 1) (4 * (k : ℤ) + 1) ↔
      x 0 = 0 ∧ ∀ i : Fin (4 * k + 1), x i.succ = -1 ∨ x i.succ = 1 := by
  constructor
  · rintro hx
    obtain ⟨hxe | hxo, hnorm⟩ := mem_shell.1 hx
    · obtain ⟨a, ha⟩ := allEven_norm_multiple_four hxe
      omega
    · have hlo := oddTail_lower hxo
      push_cast at hlo
      have hx0 : x 0 = 0 := by nlinarith [sq_nonneg (x 0)]
      refine ⟨hx0, fun i => ?_⟩
      have hi : (x i.succ) ^ 2 = 1 := by
        have hpos : 1 ≤ (x i.succ) ^ 2 := odd_square_lower (hxo.2 i)
        by_contra hne
        have hstrict : (4 * (k : ℤ) + 1) < ∑ j : Fin (4 * k + 1), (x j.succ) ^ 2 := by
          have h := sum_lt_sum (s := univ) (f := fun _ : Fin (4 * k + 1) => (1 : ℤ))
            (g := fun j => (x j.succ) ^ 2) (fun j _ => odd_square_lower (hxo.2 j))
            ⟨i, mem_univ i, lt_of_le_of_ne hpos (Ne.symm hne)⟩
          simpa using h
        rw [normSq, Fin.sum_univ_succ, hx0] at hnorm
        norm_num at hnorm
        omega
      exact (sq_eq_one_iff.1 hi).symm
  · rintro ⟨h0, htail⟩
    refine mem_shell.2 ⟨Or.inr ⟨by simp [h0], ?_⟩, ?_⟩
    · intro i
      rcases htail i with h | h <;> rw [h] <;> decide
    · have hs (i : Fin (4 * k + 1)) : (x i.succ) ^ 2 = 1 := by
        rcases htail i with h | h <;> norm_num [h]
      rw [normSq, Fin.sum_univ_succ, h0]
      simp [hs]

theorem bad_shell_not_design (k : ℕ) : ¬ IsDesign2
    (shell (4 * k + 1) (4 * (k : ℤ) + 1)) (4 * (k : ℤ) + 1) := by
  intro h
  have hzero : (∑ x ∈ shell (4 * k + 1) (4 * (k : ℤ) + 1), (x 0) ^ 2) = 0 := by
    exact sum_eq_zero fun x hx => by simp [(bad_shell_shape k).1 hx |>.1]
  have hdiag := h.2.2.2.2 0
  rw [hzero, mul_zero] at hdiag
  have hcard : 0 < ((shell (4 * k + 1) (4 * (k : ℤ) + 1)).card : ℤ) := by
    exact_mod_cast card_pos.2 h.1
  have hnorm : 0 < 4 * (k : ℤ) + 1 := by positivity
  exact (mul_pos hcard hnorm).ne' hdiag.symm

/-- An arbitrary initial run of design shells before the first failure. -/
theorem arbitrarily_many_initial_designs (k : ℕ) :
    (∀ j : ℕ, 1 ≤ j → j ≤ k →
      IsDesign2 (shell (4 * k + 1) (4 * (j : ℤ))) (4 * (j : ℤ))) ∧
    (shell (4 * k + 1) (4 * (k : ℤ) + 1)).Nonempty ∧
    ¬ IsDesign2 (shell (4 * k + 1) (4 * (k : ℤ) + 1)) (4 * (k : ℤ) + 1) := by
  refine ⟨fun j _ hj => ?_, bad_shell_nonempty k, bad_shell_not_design k⟩
  apply cubic_shell_design _ (evenShell_nonempty _ _ (by omega))
  push_cast
  omega

/-- The dimension-ten counterexample to Coulangeon–Lazzarini, Conjecture 21. -/
theorem conjecture_21_counterexample :
    (∀ r : ℤ, 0 < r → r < 9 → ((shell 9 r).Nonempty ↔ r = 4 ∨ r = 8)) ∧
    IsDesign2 (shell 9 4) 4 ∧ IsDesign2 (shell 9 8) 8 ∧
    (shell 9 9).Nonempty ∧ ¬ IsDesign2 (shell 9 9) 9 := by
  have h := arbitrarily_many_initial_designs 2
  have h4 : IsDesign2 (shell 9 4) 4 := h.1 1 (by decide) (by decide)
  have h8 : IsDesign2 (shell 9 8) 8 := h.1 2 (by decide) (by decide)
  refine ⟨?_, h4, h8, h.2⟩
  intro r hr0 hr
  constructor
  · intro hpos
    obtain ⟨j, hj1, hj2, hnorm⟩ := (norms_before_bad_shell 2 hr0 (by simpa using hr)).1 hpos
    interval_cases j <;> omega
  · rintro (rfl | rfl)
    · exact evenShell_nonempty 9 1 (by decide)
    · exact evenShell_nonempty 9 2 (by decide)

end CoulangeonLazzariniShells
