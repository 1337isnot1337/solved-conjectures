noncomputable def row (m : Fin (2^9)) : DualRow := rowData.get m.val

private theorem rows_valid_block_0 : ∀ j : Fin 64,
    DualValid 9 bounds (fun i => (0*64+j.val).testBit i.val)
      (row ⟨0*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_1 : ∀ j : Fin 64,
    DualValid 9 bounds (fun i => (1*64+j.val).testBit i.val)
      (row ⟨1*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_2 : ∀ j : Fin 64,
    DualValid 9 bounds (fun i => (2*64+j.val).testBit i.val)
      (row ⟨2*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_3 : ∀ j : Fin 64,
    DualValid 9 bounds (fun i => (3*64+j.val).testBit i.val)
      (row ⟨3*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_4 : ∀ j : Fin 64,
    DualValid 9 bounds (fun i => (4*64+j.val).testBit i.val)
      (row ⟨4*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_5 : ∀ j : Fin 64,
    DualValid 9 bounds (fun i => (5*64+j.val).testBit i.val)
      (row ⟨5*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_6 : ∀ j : Fin 64,
    DualValid 9 bounds (fun i => (6*64+j.val).testBit i.val)
      (row ⟨6*64+j.val, by omega⟩) := by decide +kernel

private theorem rows_valid_block_7 : ∀ j : Fin 64,
    DualValid 9 bounds (fun i => (7*64+j.val).testBit i.val)
      (row ⟨7*64+j.val, by omega⟩) := by decide +kernel

theorem rows_valid (m : Fin (2^9)) :
    DualValid 9 bounds (fun i => m.val.testBit i.val) (row m) := by
  let q := m.val / 64
  let j : Fin 64 := ⟨m.val % 64, Nat.mod_lt _ (by decide)⟩
  have hq : q < 8 := by dsimp [q]; omega
  have he : m.val = q*64+j.val := by dsimp [q,j]; omega
  interval_cases q
  · have hm : m = ⟨0*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_0 j
  · have hm : m = ⟨1*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_1 j
  · have hm : m = ⟨2*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_2 j
  · have hm : m = ⟨3*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_3 j
  · have hm : m = ⟨4*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_4 j
  · have hm : m = ⟨5*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_5 j
  · have hm : m = ⟨6*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_6 j
  · have hm : m = ⟨7*64+j.val, by omega⟩ := Fin.ext he
    rw [hm]
    exact rows_valid_block_7 j

