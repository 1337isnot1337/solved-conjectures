import Conjectures.MotzkinBoxTransfer
import Conjectures.MotzkinCharacterTransfer
import Mathlib.GroupTheory.FiniteAbelian.Basic
import Mathlib.LinearAlgebra.Finsupp.Defs
import Mathlib.Analysis.SpecificLimits.Basic

/-! The full two-difference Motzkin equality for compact Hausdorff abelian
groups, with Haar probability measure and continuous circle characters. -/
namespace Motzkin

open MeasureTheory MeasureTheory.Measure Filter
open scoped Topology DirectSum

theorem structured_measure_le_characterValue {F I G : Type*}
    [AddCommGroup F] [Fintype F] [Fintype I] [AddCommGroup G]
    [TopologicalSpace G] [IsTopologicalAddGroup G] [CompactSpace G] [T2Space G]
    [MeasurableSpace G] [BorelSpace G]
    (μ : Measure G) [IsProbabilityMeasure μ] [IsAddLeftInvariant μ]
    (f : (F × (I → ℤ)) →+ G) (hf : Function.Injective f)
    (a b : F × (I → ℤ)) (hgen : AddSubgroup.closure ({a,b} : Set (F × (I → ℤ)))=⊤)
    {A : Set G} (hA : MeasurableSet A) (havoid : Avoids A (f a) (f b)) :
    μ.real A ≤ characterValue (f a) (f b) := by
  classical
  let L : ℕ := Finset.univ.sup (fun i => (a.2 i).natAbs+(b.2 i).natAbs)
  have ha : ∀ i, |a.2 i| ≤ (L:ℤ) := by
    intro i
    have hi := Finset.le_sup (f:=fun i => (a.2 i).natAbs+(b.2 i).natAbs) (Finset.mem_univ i)
    have hc : (a.2 i).natAbs ≤ L := by dsimp only [L]; omega
    rw [Int.abs_eq_natAbs]
    exact_mod_cast hc
  have hb : ∀ i, |b.2 i| ≤ (L:ℤ) := by
    intro i
    have hi := Finset.le_sup (f:=fun i => (a.2 i).natAbs+(b.2 i).natAbs) (Finset.mem_univ i)
    have hc : (b.2 i).natAbs ≤ L := by dsimp only [L]; omega
    rw [Int.abs_eq_natAbs]
    exact_mod_cast hc
  have hbound (m : ℕ) (hm : 0 < m) :
      μ.real A*((m:ℝ)/(m+2*L:ℝ))^Fintype.card I ≤ characterValue (f a) (f b) := by
    obtain ⟨ψ,hψ⟩ := box_measure_character μ f a b hgen hA havoid L m hm ha hb
    exact hψ.trans (algebraic_character_le_characterValue f hf a b ψ)
  have hlim : Tendsto (fun m : ℕ => μ.real A*((m:ℝ)/(m+2*L:ℝ))^Fintype.card I)
      atTop (𝓝 (μ.real A)) := by
    simpa only [one_pow,mul_one] using
      tendsto_const_nhds.mul ((tendsto_natCast_div_add_atTop (2*(L:ℝ))).pow (Fintype.card I))
  exact le_of_tendsto hlim (eventually_atTop.2 ⟨1,fun m hm => hbound m (by omega)⟩)

theorem closure_pair_subtype {G : Type*} [AddCommGroup G] (a b : G) :
    let H := AddSubgroup.closure ({a,b} : Set G)
    let aH : H := ⟨a,AddSubgroup.subset_closure (by simp)⟩
    let bH : H := ⟨b,AddSubgroup.subset_closure (by simp)⟩
    AddSubgroup.closure ({aH,bH} : Set H)=⊤ := by
  classical
  dsimp only
  let H := AddSubgroup.closure ({a,b} : Set G)
  let aH : H := ⟨a,AddSubgroup.subset_closure (by simp)⟩
  let bH : H := ⟨b,AddSubgroup.subset_closure (by simp)⟩
  let K := AddSubgroup.closure ({aH,bH} : Set H)
  have hmap : K.map H.subtype=H := by
    change (AddSubgroup.closure ({aH,bH} : Set H)).map H.subtype=H
    rw [AddMonoidHom.map_closure]
    simp only [Set.image_insert_eq,Set.image_singleton]
    rfl
  apply top_unique
  intro x _
  have hx : (x:G) ∈ K.map H.subtype := by rw [hmap]; exact x.property
  obtain ⟨y,hy,he⟩ := hx
  have hey : y=x := Subtype.ext he
  exact hey ▸ hy

/-- Every Borel avoiding set in a compact abelian group is bounded by the
continuous-character supremum. The subgroup generated by the differences may
be infinite, nonclosed, and noncyclic. -/
theorem compact_measure_le_characterValue {G : Type*} [AddCommGroup G]
    [TopologicalSpace G] [IsTopologicalAddGroup G] [CompactSpace G] [T2Space G]
    [MeasurableSpace G] [BorelSpace G]
    (μ : Measure G) [IsProbabilityMeasure μ] [IsAddLeftInvariant μ]
    (a b : G) {A : Set G} (hA : MeasurableSet A) (havoid : Avoids A a b) :
    μ.real A ≤ characterValue a b := by
  classical
  let H := AddSubgroup.closure ({a,b} : Set G)
  let aH : H := ⟨a,AddSubgroup.subset_closure (by simp)⟩
  let bH : H := ⟨b,AddSubgroup.subset_closure (by simp)⟩
  have hgenH : AddSubgroup.closure ({aH,bH} : Set H)=⊤ := closure_pair_subtype a b
  let _ : AddGroup.FG H := AddGroup.fg_iff.mpr
    ⟨{aH,bH},hgenH,Set.finite_insert _ (Set.finite_singleton _)⟩
  obtain ⟨d,ι,hι,p,hp,e,⟨E⟩⟩ := AddCommGroup.equiv_free_prod_directSum_zmod H
  let _ : Fintype ι := hι
  let _ : ∀ i, NeZero (p i^e i) := fun i => ⟨pow_ne_zero _ (hp i).ne_zero⟩
  let F := ⨁ i : ι, ZMod (p i^e i)
  let _ : Fintype F := Fintype.ofEquiv (∀ i, ZMod (p i^e i)) DFinsupp.equivFunOnFintype.symm
  let E' : H ≃+ F × (Fin d → ℤ) :=
    (E.trans ((Finsupp.linearEquivFunOnFinite ℤ ℤ (Fin d)).toAddEquiv.prodCongr
      (AddEquiv.refl F))).trans (AddEquiv.prodComm _ _)
  let f : (F × (Fin d → ℤ)) →+ G := H.subtype.comp E'.symm.toAddMonoidHom
  have hf : Function.Injective f := Subtype.val_injective.comp E'.symm.injective
  have hgen : AddSubgroup.closure ({E' aH,E' bH} : Set (F × (Fin d → ℤ)))=⊤ :=
    closure_pair_image E'.toAddMonoidHom E'.surjective aH bH hgenH
  have hfa : f (E' aH)=a := by
    change ((E'.symm (E' aH):H):G)=a
    rw [E'.symm_apply_apply]
    rfl
  have hfb : f (E' bH)=b := by
    change ((E'.symm (E' bH):H):G)=b
    rw [E'.symm_apply_apply]
    rfl
  have havoid' : Avoids A (f (E' aH)) (f (E' bH)) := by
    simpa only [hfa,hfb] using havoid
  simpa only [hfa,hfb] using
    structured_measure_le_characterValue μ f hf (E' aH) (E' bH) hgen hA havoid'

/-- The full compact two-difference Motzkin theorem, for actual measurable-set
and continuous-character suprema. The statement includes zero differences. -/
theorem compact_two_difference_theorem {G : Type*} [AddCommGroup G]
    [TopologicalSpace G] [IsTopologicalAddGroup G] [CompactSpace G] [T2Space G]
    [MeasurableSpace G] [BorelSpace G]
    (μ : Measure G) [IsProbabilityMeasure μ] [IsAddLeftInvariant μ] (a b : G) :
    density μ a b=characterValue a b := by
  apply le_antisymm
  · apply density_le μ
    intro A hA havoid
    exact compact_measure_le_characterValue μ a b hA havoid
  · exact characterValue_le_density μ a b

end Motzkin
