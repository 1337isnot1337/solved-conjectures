import Conjectures.ChenKhareSahiJackUnique
import Conjectures.ChenKhareSahiJackCertificate

/-!
# Lean verification of the Chen–Khare–Sahi Conjecture 4 counterexample

Five variables, source parameter `σ = 1` (normalized Schur polynomials), target
parameter `τ = 3/2` (Stanley's `α = 2/3`), partitions `(3,2) ⪰ (3,1,1)`. The normalized
Jack difference is not in the full source semiring.

Certificate. Only degree-five products matter after homogeneous extraction. Record each
function by its values at `(1,1,1,0,0)`, `(2,1,0,0,0)` and `(1,1,1,1,0)`. In each degree
`d ≤ 5` the value vectors of all degree-`d` generator products form the finite list
`tab d`; the lists are closed under multiplication, so every homogeneous semiring element
of degree five has its value vector in the cone of `tab 5`. The functional
`-45 f(1,1,1,0,0) + 10 f(2,1,0,0,0) + 18 f(1,1,1,1,0)` is nonnegative on `tab 5` and
equals `-3/4522` on the normalized Jack difference. All finite checks are kernel
reductions (`decide +kernel`); no native computation is used.
-/

namespace ChenKhareSahi.Jack

noncomputable section

set_option maxRecDepth 65536
set_option maxHeartbeats 64000000

/-! ## The target -/

/-- The normalized Jack difference `P_{(3,2)}/P_{(3,2)}(1⁵) - P_{(3,1,1)}/P_{(3,1,1)}(1⁵)`
for a degree-five Jack family `F` (index 4 is `(3,2)` and index 3 is `(3,1,1)`). -/
def jackTarget (F : Index → Index → ℝ) (x : Pt) : ℝ :=
  jackPoly (F 4) x / jackPoly (F 4) 1 - jackPoly (F 3) x / jackPoly (F 3) 1

theorem jparts_witness : jpart5 4 = ![3, 2, 0, 0, 0] ∧ jpart5 3 = ![3, 1, 1, 0, 0] := by
  decide +kernel

theorem jackTarget_smul (F : Index → Index → ℝ) (t : ℝ) (x : Pt) :
    jackTarget F (t • x) = t ^ 5 * jackTarget F x := by
  simp only [jackTarget, jackPoly_smul]
  ring

/-- Natural-number value of a literal monomial. -/
def termN (e : List ℕ) (a : Fin 5 → ℕ) : ℕ :=
  a 0 ^ e[0]! * a 1 ^ e[1]! * a 2 ^ e[2]! * a 3 ^ e[3]! * a 4 ^ e[4]!

def monomialN (i : Index) (a : Fin 5 → ℕ) : ℕ := ((orbitList i).map fun e => termN e a).sum

theorem monomial_natPt (i : Index) (a : Fin 5 → ℕ) :
    monomial i (natPt a) = (monomialN i a : ℝ) := by
  rw [monomial_eq_list, monomialN, Nat.cast_list_sum, List.map_map]
  congr 1
  apply List.map_congr_left
  intro e _
  simp [term, termN, natPt]

theorem monomialN_pt1 (i : Index) : monomialN i pt1 = ![0, 0, 3, 3, 6, 6, 3] i := by
  revert i; decide +kernel
theorem monomialN_pt2 (i : Index) : monomialN i pt2 = ![0, 0, 0, 0, 12, 18, 33] i := by
  revert i; decide +kernel
theorem monomialN_pt3 (i : Index) : monomialN i pt3 = ![0, 4, 12, 12, 12, 12, 4] i := by
  revert i; decide +kernel
theorem monomialN_ones (i : Index) : monomialN i ![1, 1, 1, 1, 1] = ![1, 20, 30, 30, 20, 20, 5] i := by
  revert i; decide +kernel

theorem jackTarget_sep : sepR (val (jackTarget jackR)) = -3 / 4522 := by
  simp only [sepR, val, jackTarget, one_eq_natPt, jackPoly, monomial_natPt, monomialN_pt1,
    monomialN_pt2, monomialN_pt3, monomialN_ones]
  simp [Fin.sum_univ_succ, jackR, jackQ]
  norm_num

/-! ## The counterexample -/

/-- **Chen–Khare–Sahi Conjecture 4 is false.** With five variables, source parameter
`σ = 1`, target parameter `τ = 3/2` (Stanley's `α = 2/3`) and `(3,2) ⪰ (3,1,1)`, the
normalized difference of the target Jack polynomials, characterized by Stanley's
definition, is not in the full source semiring generated by normalized Schur polynomials
and normalized dominance differences. The degree-five Jack family exists and is unique. -/
theorem conjecture4_counterexample :
    Dominates ![3, 2, 0, 0, 0] ![3, 1, 1, 0, 0] ∧
      (∃! F : Index → Index → ℝ, IsJackFamily F) ∧
      ∀ F : Index → Index → ℝ, IsJackFamily F → ¬ SchurSemiring (jackTarget F) := by
  refine ⟨(dominates_iff _ _).mpr (by decide +kernel), family_exists_unique, ?_⟩
  intro F hF hS
  rw [family_unique F hF] at hS
  obtain ⟨as, has, hexp⟩ := hS.expand
  have hdeg := eq_degreePart 5 as (jackTarget jackR) (jackTarget_smul jackR) hexp
  have hcone := (degreePart_hom 5 as has).cone le_rfl
  have hval : val (jackTarget jackR) = val (degreePart 5 as) := by
    simp only [val, hdeg]
  have hnn := Cone.sep_nonneg tab5_sep hcone
  rw [← hval, jackTarget_sep] at hnn
  norm_num at hnn

end

end ChenKhareSahi.Jack
