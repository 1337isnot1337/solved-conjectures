def left (s : Fin 1458) : Fin 27 := Fin.ofNat 27 (s.val/(27*2))
def right (s : Fin 1458) : Fin 27 := Fin.ofNat 27 ((s.val/2)%27)
def carry (s : Fin 1458) : Fin 2 := Fin.ofNat 2 (s.val%2)
def pack (a : Fin 27) (b : Fin 27) (c : Fin 2) : Fin 1458 :=
  Fin.ofNat 1458 ((a.val*27+b.val)*2+c.val)

def encoding : ProductEncoding 27 27 1458 := {
  left := left, right := right, carry := carry, pack := pack
  left_pack := by
    intro a b c
    apply Fin.ext
    have ha := a.isLt
    have hb := b.isLt
    have hc := c.isLt
    simp only [left,pack,Fin.val_ofNat]
    omega
  right_pack := by
    intro a b c
    apply Fin.ext
    have ha := a.isLt
    have hb := b.isLt
    have hc := c.isLt
    simp only [right,pack,Fin.val_ofNat,Nat.mod_mod]
    omega
  carry_pack := by
    intro a b c
    apply Fin.ext
    have ha := a.isLt
    have hb := b.isLt
    have hc := c.isLt
    simp only [carry,pack,Fin.val_ofNat,Nat.mod_mod]
    omega
  pack_parts := by
    intro q
    apply Fin.ext
    have hq := q.isLt
    simp only [left,right,carry,pack,Fin.val_ofNat,Nat.mod_mod]
    omega
}

