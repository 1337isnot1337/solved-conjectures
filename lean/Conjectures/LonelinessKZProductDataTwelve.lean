import Conjectures.LonelinessKZProductDataTwelveBlock00
import Conjectures.LonelinessKZProductDataTwelveBlock01
import Conjectures.LonelinessKZProductDataTwelveBlock02
import Conjectures.LonelinessKZProductDataTwelveBlock03
import Conjectures.LonelinessKZProductDataTwelveBlock04
import Conjectures.LonelinessKZProductDataTwelveBlock05
import Conjectures.LonelinessKZProductDataTwelveBlock06
import Conjectures.LonelinessKZProductDataTwelveBlock07

/-! All 2048 eleven-dimensional subset certificates, assembled from
eight independently checked blocks. No real variables are sampled.
Generated by scripts/generate_loneliness_kz_certificates.py. -/

namespace Loneliness.KZProduct.Twelve

set_option maxRecDepth 100000
set_option maxHeartbeats 0

noncomputable def blockCertificate (b : Fin 8) (m : Fin 256) : FastRow :=
  match b.val with
  | 0 => Block00.certificate m
  | 1 => Block01.certificate m
  | 2 => Block02.certificate m
  | 3 => Block03.certificate m
  | 4 => Block04.certificate m
  | 5 => Block05.certificate m
  | 6 => Block06.certificate m
  | 7 => Block07.certificate m
  | _ => default

private theorem block_valid (b : Fin 8) (m : Fin 256) :
    FastValid 11 bounds (fun i => (b.val*256+m.val).testBit i.val)
      (blockCertificate b m) := by
  fin_cases b
  · simpa only [blockCertificate, Fin.val_mk] using
      Block00.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block01.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block02.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block03.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block04.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block05.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block06.rows_valid m
  · simpa only [blockCertificate, Fin.val_mk] using
      Block07.rows_valid m

noncomputable def certificate (m : Fin (2^11)) : FastRow :=
  assembleCertificate blockCertificate m

noncomputable def row (m : Fin (2^11)) : DualRow := (certificate m).dual

theorem rows_valid (m : Fin (2^11)) :
    DualValid 11 bounds (fun i => m.val.testBit i.val) (row m) := by
  apply fast_valid_correct bounds (fun i => m.val.testBit i.val) (certificate m)
  exact assemble_valid blockCertificate block_valid m

end Loneliness.KZProduct.Twelve
