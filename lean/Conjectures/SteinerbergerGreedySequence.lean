import Mathlib.Algebra.Order.Floor.Ring
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Tactic

/-!
# Steinerberger's greedy-energy Fourier conjecture

The periodic Bernoulli kernel and an actual infinite greedy sequence.  The
sequence is the classical base-two van der Corput sequence.  The elementary
two-point multiplication identity proves admissibility by even/odd recursion.

This is the singleton-start instance of the dyadic construction in
`results/steinerberger-greedy-fourier/PROOF.md`.  The general greedy structure
is due to Florian Pausinger, *Greedy energy minimization can count in binary*,
Theorems 2.1 and 5.5; see also Ralph Kritzinger, arXiv:2109.06298v4, Theorem 4 and Algorithm 3 (page 15).
The conjecture itself is Stefan Steinerberger, *Some Open Problems*,
31 March 2026 revision, section 20.
-/

open Finset

namespace Conjectures.SteinerbergerGreedy

noncomputable section

/-- The periodic extension of the second Bernoulli polynomial. -/
def kernel (t : ℝ) : ℝ := (Int.fract t)^2 - Int.fract t + 1 / 6

theorem kernel_add_one (t : ℝ) : kernel (t + 1) = kernel t := by
  simp [kernel]

theorem kernel_sub_one (t : ℝ) : kernel (t - 1) = kernel t := by
  simp [kernel]

theorem kernel_fract (t : ℝ) : kernel (Int.fract t) = kernel t := by
  simp [kernel]

theorem kernel_of_mem {t : ℝ} (ht : t ∈ Set.Ico 0 1) :
    kernel t = t^2 - t + 1 / 6 := by
  rw [kernel, Int.fract_eq_self.mpr ht]

theorem kernel_min (t : ℝ) : -(1 / 12 : ℝ) ≤ kernel t := by
  unfold kernel
  nlinarith [sq_nonneg (Int.fract t - 1 / 2)]

theorem kernel_half : kernel (1 / 2) = -(1 / 12 : ℝ) := by
  rw [kernel_of_mem (by constructor <;> norm_num)]
  norm_num

/-- The Bernoulli multiplication identity for the two opposite points. -/
theorem kernel_pair (t : ℝ) :
    kernel t + kernel (t - 1 / 2) = kernel (2 * t) / 2 := by
  have local_pair (u : ℝ) (hu : u ∈ Set.Ico 0 1) :
      kernel u + kernel (u - 1 / 2) = kernel (2 * u) / 2 := by
    rw [kernel_of_mem hu]
    by_cases h : u < 1 / 2
    · rw [← kernel_add_one (u - 1 / 2)]
      rw [kernel_of_mem (by constructor <;> linarith [hu.1]),
        kernel_of_mem (by constructor <;> linarith [hu.1])]
      ring
    · rw [kernel_of_mem (by constructor <;> linarith [hu.2]),
        ← kernel_sub_one (2 * u),
        kernel_of_mem (by constructor <;> linarith [hu.2])]
      ring
  have h := local_pair (Int.fract t) ⟨Int.fract_nonneg t, Int.fract_lt_one t⟩
  simpa only [kernel, Int.fract_fract, Int.fract_fract_sub,
    two_mul, Int.fract_fract_add_fract] using h

/-- Binary digit reversal, with `vdc 0 = 0`. -/
def vdc (n : ℕ) : ℝ :=
  if hn : n = 0 then 0 else (vdc (n / 2) + (n % 2 : ℕ)) / 2
termination_by n
decreasing_by exact Nat.div_lt_self (Nat.pos_of_ne_zero hn) (by decide)

@[simp] theorem vdc_zero : vdc 0 = 0 := by rw [vdc]; simp

theorem vdc_even (n : ℕ) : vdc (2 * n) = vdc n / 2 := by
  by_cases hn : n = 0
  · subst n; simp
  · rw [vdc, dite_eq_right (by omega)]
    simp

theorem vdc_odd (n : ℕ) : vdc (2 * n + 1) = (vdc n + 1) / 2 := by
  rw [vdc, dite_eq_right (by omega)]
  rw [show (2 * n + 1) / 2 = n by omega]
  simp

theorem vdc_mem (n : ℕ) : vdc n ∈ Set.Ico 0 1 := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn : n = 0
    · subst n; simp
    · rw [vdc, dite_eq_right hn]
      have hdiv := ih (n / 2) (Nat.div_lt_self (by omega) (by decide))
      have hmod' : ((n % 2 : ℕ) : ℝ) ≤ 1 := by
        exact_mod_cast (show n % 2 ≤ 1 by omega)
      constructor
      · exact div_nonneg (add_nonneg hdiv.1 (Nat.cast_nonneg _)) (by norm_num)
      · linarith [hdiv.2]

/-- Partition a finite prefix into its consecutive even/odd pairs. -/
theorem sum_pairs {A : Type*} [AddCommMonoid A] (f : ℕ → A) (n : ℕ) :
    ∑ a ∈ range (2 * n), f a = ∑ a ∈ range n, (f (2*a) + f (2*a+1)) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Nat.mul_succ, show 2*n+2 = (2*n+1)+1 by omega,
      sum_range_succ, sum_range_succ, sum_range_succ, ih]
    simp [add_assoc]

/-- The potential generated by the first `n` points. -/
def potential (n : ℕ) (t : ℝ) : ℝ :=
  ∑ a ∈ range n, kernel (t - vdc a)

theorem potential_add_one (n : ℕ) (t : ℝ) :
    potential n (t + 1) = potential n t := by
  unfold potential
  apply sum_congr rfl
  intro a _
  rw [show t + 1 - vdc a = (t - vdc a) + 1 by ring, kernel_add_one]

theorem potential_even (n : ℕ) (t : ℝ) :
    potential (2*n) t = potential n (2*t) / 2 := by
  rw [potential, sum_pairs]
  simp_rw [vdc_even, vdc_odd]
  calc
    _ = ∑ a ∈ range n, kernel (2*t - vdc a) / 2 := by
      apply sum_congr rfl
      intro a _
      have h := kernel_pair (t - vdc a / 2)
      rw [show t - vdc a / 2 - 1 / 2 = t - (vdc a + 1) / 2 by ring,
        show 2 * (t - vdc a / 2) = 2*t - vdc a by ring] at h
      exact h
    _ = potential n (2*t) / 2 := by rw [← sum_div]; rfl

theorem potential_odd (n : ℕ) (t : ℝ) :
    potential (2*n+1) t = potential n (2*t) / 2 + kernel (t - vdc n / 2) := by
  rw [potential, sum_range_succ, ← potential, potential_even, vdc_even]

/-- Every next van der Corput point globally minimizes the existing potential. -/
theorem vdc_minimizes (n : ℕ) (t : ℝ) :
    potential n (vdc n) ≤ potential n t := by
  induction n using Nat.strong_induction_on generalizing t with
  | h n ih =>
    by_cases hn : n = 0
    · subst n; simp [potential]
    · have hlt : n / 2 < n := Nat.div_lt_self (by omega) (by decide)
      have hm : n % 2 = 0 ∨ n % 2 = 1 := by omega
      rcases hm with hm | hm
      · have he : n = 2*(n/2) := by omega
        conv_lhs => rw [he, vdc_even, potential_even]
        conv_rhs => rw [he, potential_even]
        have hi := ih (n/2) hlt (2*t)
        simpa only [mul_div_cancel₀ _ (by norm_num : (2:ℝ) ≠ 0)] using
          div_le_div_of_nonneg_right hi (by norm_num : (0:ℝ) ≤ 2)
      · have ho : n = 2*(n/2)+1 := by omega
        conv_lhs => rw [ho, vdc_odd, potential_odd]
        conv_rhs => rw [ho, potential_odd]
        rw [show 2*((vdc (n/2)+1)/2) = vdc (n/2)+1 by ring,
          potential_add_one,
          show (vdc (n/2)+1)/2 - vdc (n/2)/2 = 1/2 by ring, kernel_half]
        have hi := ih (n/2) hlt (2*t)
        have hk := kernel_min (t - vdc (n/2)/2)
        linarith

/-- The source's singleton-initialized greedy rule, using real representatives. -/
def IsGreedy (x : ℕ → ℝ) : Prop :=
  (∀ n, x n ∈ Set.Ico 0 1) ∧
  ∀ n, 1 ≤ n → ∀ t : ℝ,
    (∑ a ∈ range n, kernel (x n - x a)) ≤ ∑ a ∈ range n, kernel (t - x a)

theorem vdc_isGreedy : IsGreedy vdc := by
  exact ⟨vdc_mem, fun n _ t => vdc_minimizes n t⟩

end
end Conjectures.SteinerbergerGreedy
