theorem starts_size : starts.size = 70 := by decide
theorem goodMasks_size : goodMasks.size = 210 := by decide

def goodMask (i : Fin 210) : ℕ := goodMasks[i.val]'(by rw [goodMasks_size]; exact i.isLt)
def sample (i : Fin 210) : ℕ := starts[i.val / 3]'(by rw [starts_size]; omega)
def residue (i : Fin 210) : ℕ := match i.val % 3 with
  | 0 => 1
  | 1 => 2
  | _ => 4
def quotient (i : Fin 210) (j : Fin 5) : ℕ := ((j.val + 1) * sample i / 60) % 7
def Accepts (i : Fin 210) (j : Fin 5) (k : Fin 7) : Prop :=
  (quotient i j + k.val * residue i) % 7 ≠ 0 ∧
  (quotient i j + k.val * residue i) % 7 ≠ 6
instance (i : Fin 210) (j : Fin 5) (k : Fin 7) : Decidable (Accepts i j k) :=
  inferInstanceAs (Decidable (_ ∧ _))

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem goodMask_correct : ∀ (i : Fin 210) (j : Fin 5) (k : Fin 7),
    (goodMask i).testBit (7 * j.val + k.val) = decide (Accepts i j k) := by
  decide

def rowCount (w : ℕ) : ℕ :=
  w % 2 + (w >>> 1) % 2 + (w >>> 2) % 2 + (w >>> 3) % 2 +
    (w >>> 4) % 2 + (w >>> 5) % 2 + (w >>> 6) % 2
def rowSafe (w : ℕ) : Bool := decide (3 ≤ rowCount w)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem row_certificate_zero : ∀ (r : Fin 128) (i : Fin 210),
    rowSafe r.val = true → (r.val &&& goodMask i) ≠ 0 := by
  decide

end Loneliness.PrimeFilteringFourProfiles
