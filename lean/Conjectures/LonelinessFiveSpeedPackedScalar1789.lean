import Conjectures.LonelinessFiveSpeedPackedScalar
import Conjectures.LonelinessFiveSpeedScalarTreeMask1789

set_option maxRecDepth 20000
set_option maxHeartbeats 0
set_option Elab.async false

namespace Loneliness.FiveSpeedCertificate.PackedScalars.P1789

/-! A literal packed oracle. Its finite equality certificate is checked
against the existing scalar tree, including the zero block. -/

noncomputable def packed : ℕ := nat_lit 

noncomputable def mask : ℕ → ℕ := packedScalarMask 1789 packed

theorem checked :
    packedScalarTreeCheck 1789 packed ScalarTrees.P1789.tree = true := by
  decide +kernel

theorem mask_eq_treeMask :
    mask = treeMask 1789 ScalarTrees.P1789.tree :=
  packedScalarMask_eq_treeMask_function 1789 packed ScalarTrees.P1789.tree checked

theorem sound (a : ℕ) : GoodMask 1789 a (mask a) :=
  packedScalarTreeCheck_sound 1789 packed ScalarTrees.P1789.tree
    ScalarTrees.P1789.checked checked a

end Loneliness.FiveSpeedCertificate.PackedScalars.P1789
