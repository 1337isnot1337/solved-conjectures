/-!
# Hegyvári's conjecture

Candidate extension of the actual tower argument of Jensen Kohlmeyer and
Liam Kruer, using the source-pinned adaptation generated by
`scripts/prepare_hegyvari_tower_dependency.py`.

This file is NOT a verified result until strict compilation, full transitive
axiom inspection and stock replay of its complete dependency closure pass.
The existing repository proof, Sections 2--4, supplies the mathematical
argument. No claim to the prior irrational-ratio proof is made.
-/

namespace Bounty.Erdos354Formal

open Filter Topology MeasureTheory
open scoped BigOperators

theorem hegyvari_height_cast {a : ℝ} (ha : 0 ≤ a) (n : ℕ) :
    (HegyvariFloorDoubling.floorRay a n : ℤ) = height a n := by
  unfold HegyvariFloorDoubling.floorRay height Erdos354.FloorMultiples
  exact Int.natCast_floor_eq_floor
    (mul_nonneg (pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) _) ha)

theorem hegyvari_digit_iff {a : ℝ} (ha : 0 ≤ a) (n : ℕ) :
    HegyvariFloorDoubling.floorDigit a n = true ↔ Ones a n := by
  rw [HegyvariFloorDoubling.floorDigit, decide_eq_true_eq, Ones, digit,
    ← hegyvari_height_cast ha (n + 1), ← hegyvari_height_cast ha n]
  omega

theorem hegyvari_unbounded {a : ℝ} (ha : 0 ≤ a) (hnd : ¬ Dyadic a) :
    HegyvariFloorDoubling.UnboundedMarks (HegyvariFloorDoubling.floorDigit a) := by
  intro N
  obtain ⟨n, hn, hmark⟩ := unboundedOnes_of_not_dyadic hnd N
  exact ⟨n, hn, (hegyvari_digit_iff ha n).mpr hmark⟩

theorem hegyvari_transport {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b)
    (h : ∃ s, 0 < s ∧ ForwardTransport (Ones a) (Ones b) s) :
    HegyvariFloorDoubling.ForwardTransport
      (HegyvariFloorDoubling.floorDigit a) (HegyvariFloorDoubling.floorDigit b) := by
  rcases h with ⟨s, hs, M, hM, N, h⟩
  refine ⟨s, M, N, hs, hM, ?_⟩
  intro i hi himark
  obtain ⟨j, h₁, h₂, hj⟩ := h i hi ((hegyvari_digit_iff ha i).mp himark)
  exact ⟨j, h₁, h₂, (hegyvari_digit_iff hb j).mpr hj⟩

theorem hegyvari_bounded {a : ℝ} (ha : 0 ≤ a)
    (h : HegyvariFloorDoubling.BoundedGaps (HegyvariFloorDoubling.floorDigit a)) :
    BoundedZeroRuns (Ones a) := by
  rcases h with ⟨H, hH, h⟩
  refine ⟨H, hH, ?_⟩
  intro n
  obtain ⟨j, hj₁, hj₂, hj⟩ := h n
  exact ⟨j, hj₁, hj₂, (hegyvari_digit_iff ha j).mp hj⟩

/-- Case I: both ratios are non-dyadic, and at least one ray has
unbounded ones. The transport and bounded-gap criteria are the actual
theorems of the adapted tower development. -/
theorem hegyvari_disjoint_nondyadic_ratios {a b : ℝ}
    (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hab : ¬ Dyadic (a / b)) (hba : ¬ Dyadic (b / a))
    (hnd : ¬ Dyadic a ∨ ¬ Dyadic b) : SymbolicallyDisjoint a b := by
  have ha0 : 0 ≤ a := by linarith
  have hb0 : 0 ≤ b := by linarith
  apply HegyvariFloorDoubling.disjoint_of_two_transport_criteria
    (u := HegyvariFloorDoubling.floorDigit a)
    (v := HegyvariFloorDoubling.floorDigit b)
  · rcases hnd with h | h
    · exact Or.inl (hegyvari_unbounded ha0 h)
    · exact Or.inr (hegyvari_unbounded hb0 h)
  · intro hnot
    exact hegyvari_transport ha0 hb0
      (forwardTransport_of_not_symbolicallyDisjoint ha hb hba hnot)
  · intro hnot
    exact hegyvari_transport hb0 ha0
      (forwardTransport_of_not_symbolicallyDisjoint hb ha hab (fun h => hnot h.symm))
  · intro h
    exact symbolicallyDisjoint_of_boundedZeroRuns ha hb hba (hegyvari_bounded ha0 h)
  · intro h
    exact (symbolicallyDisjoint_of_boundedZeroRuns hb ha hab
      (hegyvari_bounded hb0 h)).symm

/-- The integer floor of a nonnegative dyadic quotient is the
corresponding natural-number quotient. -/
theorem hegyvari_floor_nat_div_pow (q k : ℕ) :
    ⌊(q : ℝ) / (2 : ℝ)^k⌋ = ((q / 2^k : ℕ) : ℤ) := by
  simpa only [Nat.cast_pow, Nat.cast_ofNat, Int.floor_natCast, Int.natCast_ediv] using
    Int.floor_div_natCast (q : ℝ) (2 ^ k)

/-- An odd positive integer divided by a positive power of two is
strictly between consecutive integers. -/
theorem hegyvari_odd_quotient_nonintegral (l j : ℕ) (hl : l % 2 = 1)
    (hj : 0 < j) :
    (l : ℝ) / (2 : ℝ)^j ≠ (⌊(l : ℝ) / (2 : ℝ)^j⌋ : ℤ) := by
  intro he
  have he' : (l : ℝ) = (⌊(l : ℝ) / (2 : ℝ)^j⌋ : ℤ) * (2 : ℝ)^j :=
    (div_eq_iff (by positivity : (2 : ℝ)^j ≠ 0)).mp he
  have hi : (l : ℤ) = ⌊(l : ℝ) / (2 : ℝ)^j⌋ * (2 : ℤ)^j := by exact_mod_cast he'
  obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
  rw [hk, pow_succ, ← mul_assoc] at hi
  omega

/-- Stability of a bit ABOVE the scaled binary point: the old
fractional-prefix lemma does not cover this case. -/
theorem hegyvari_eventually_high_bit {q L : ℕ → ℕ} {l j : ℕ}
    (hq : Tendsto (fun r => (q r : ℝ) / (2 : ℝ)^(L r)) atTop (𝓝 (l : ℝ)))
    (hl : l % 2 = 1) (hj : 0 < j) :
    ∀ᶠ r in atTop, (q r).testBit (L r+j) = l.testBit j := by
  have ht := hq.div_const ((2 : ℝ)^j)
  have hf := eventually_floor_eq_of_tendsto ht (hegyvari_odd_quotient_nonintegral l j hl hj)
  filter_upwards [hf] with r hr
  change ⌊((q r : ℝ) / (2 : ℝ)^(L r)) / (2 : ℝ)^j⌋ =
    ⌊(l : ℝ) / (2 : ℝ)^j⌋ at hr
  rw [div_div, ← pow_add, hegyvari_floor_nat_div_pow, hegyvari_floor_nat_div_pow] at hr
  have hdiv : q r / 2^(L r+j) = l / 2^j := by exact_mod_cast hr
  have hbit : ((q r).testBit (L r+j)).toNat = (l.testBit j).toNat := by
    rw [testBit_toNat, testBit_toNat, hdiv]
  cases h₀ : (q r).testBit (L r+j) <;> cases h₁ : l.testBit j <;> simp_all

/-- A positive integer at least three has a leading one at a positive
bit position and zeros at the next two positions. -/
theorem hegyvari_top_bits (l : ℕ) (hl : 3 ≤ l) :
    ∃ j : ℕ, 0 < j ∧ l.testBit j = true ∧
      l.testBit (j+1) = false ∧ l.testBit (j+2) = false := by
  let j := Nat.log 2 l
  have hj : 0 < j := Nat.log_pos (by decide : 1 < (2 : ℕ)) (by omega)
  have hlow : 2^j ≤ l := Nat.pow_log_le_self 2 (by omega)
  have hhigh : l < 2^(j+1) := Nat.lt_pow_succ_log_self (by decide : 1 < (2 : ℕ)) l
  have hdiv : l / 2^j = 1 := by
    apply Nat.div_eq_of_lt_le
    · simpa using hlow
    · simpa only [pow_succ, one_add, Nat.mul_comm] using hhigh
  have h₂ : l < 2^(j+2) := hhigh.trans_le (Nat.pow_le_pow_right (by decide) (by omega))
  refine ⟨j, hj, ?_, ?_, ?_⟩
  · have h := testBit_toNat l j
    rw [hdiv] at h
    cases he : l.testBit j <;> simp_all
  · have h := testBit_toNat l (j+1)
    rw [Nat.div_eq_of_lt hhigh] at h
    cases he : l.testBit (j+1) <;> simp_all
  · have h := testBit_toNat l (j+2)
    rw [Nat.div_eq_of_lt h₂] at h
    cases he : l.testBit (j+2) <;> simp_all

/-- The common integer-part mark at k = L+j for both neighboring
return queries. This is the new odd-integer-ratio step of the proof. -/
theorem hegyvari_odd_common_marks {a b : ℝ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    {l j : ℕ} (hodd : l % 2 = 1) (hj : 0 < j)
    (hratio : b / a = (l : ℝ))
    (hbits : l.testBit j = true ∧ l.testBit (j+1) = false ∧ l.testBit (j+2) = false)
    (n : ℕ → ℕ) (hn : Tendsto n atTop atTop)
    (hmark : ∀ r, digit a (n r + j + 1) = 1) :
    ∀ᶠ r in atTop,
      let m := n r / 2
      let q := returnBlock a m (height b (n r))
      let k := n r - m + j
      digit a (m+k+1) = 1 ∧ q.testBit k ≠ q.testBit (k+1) ∧
        (q+1).testBit k ≠ (q+1).testBit (k+1) ∧
          ∀ i < 3, q.testBit (k+i) = (q+1).testBit (k+i) := by
  let m := fun r => n r / 2
  let L := fun r => n r - n r / 2
  let q := fun r => returnBlock a (m r) (height b (n r))
  have hm : Tendsto m atTop atTop := nat_half_tendsto.comp hn
  have hL : Tendsto L atTop atTop := nat_other_half_tendsto.comp hn
  have htotal : ∀ r, m r + L r = n r := by intro r; dsimp [m, L]; omega
  have hq : Tendsto (fun r => (q r : ℝ) / (2 : ℝ)^(L r)) atTop (𝓝 (l : ℝ)) := by
    simpa only [htotal, hratio] using crossReturnQuery_scaled_tendsto ha hb m L hm hL
  have hq' : Tendsto (fun r => ((q r+1 : ℕ) : ℝ) / (2 : ℝ)^(L r)) atTop (𝓝 (l : ℝ)) := by
    simpa only [htotal, hratio] using crossReturnQuery_succ_scaled_tendsto ha hb m L hm hL
  filter_upwards [hegyvari_eventually_high_bit hq hodd hj,
    hegyvari_eventually_high_bit hq hodd (show 0 < j+1 by omega),
    hegyvari_eventually_high_bit hq hodd (show 0 < j+2 by omega),
    hegyvari_eventually_high_bit hq' hodd hj,
    hegyvari_eventually_high_bit hq' hodd (show 0 < j+1 by omega),
    hegyvari_eventually_high_bit hq' hodd (show 0 < j+2 by omega)] with r h₀ h₁ h₂ h₀' h₁' h₂'
  change digit a (m r+(L r+j)+1) = 1 ∧
    (q r).testBit (L r+j) ≠ (q r).testBit (L r+j+1) ∧
    (q r+1).testBit (L r+j) ≠ (q r+1).testBit (L r+j+1) ∧
    (∀ i < 3, (q r).testBit (L r+j+i) = (q r+1).testBit (L r+j+i))
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [show m r + (L r+j)+1 = n r+j+1 by have := htotal r; omega]
    exact hmark r
  · simpa only [Nat.add_assoc, hbits.1, hbits.2.1] using
      (show (q r).testBit (L r+j) ≠ (q r).testBit (L r+(j+1)) by
        rw [h₀, h₁, hbits.1, hbits.2.1]; decide)
  · simpa only [Nat.add_assoc, hbits.1, hbits.2.1] using
      (show (q r+1).testBit (L r+j) ≠ (q r+1).testBit (L r+(j+1)) by
        rw [h₀', h₁', hbits.1, hbits.2.1]; decide)
  · intro i hi
    interval_cases i
    · simpa only [Nat.add_zero] using h₀.trans h₀'.symm
    · simpa only [Nat.add_assoc] using h₁.trans h₁'.symm
    · simpa only [Nat.add_assoc] using h₂.trans h₂'.symm

/-- Reciprocal of an odd integer larger than one is non-dyadic. -/
theorem hegyvari_reciprocal_nondyadic (l : ℕ) (hl : 3 ≤ l) (hodd : l % 2 = 1) :
    ¬ Dyadic (1 / (l : ℝ)) := by
  rintro ⟨k, z, he⟩
  have hp : (0 : ℝ) < (l : ℝ) := by exact_mod_cast (show 0 < l by omega)
  have h := (eq_div_iff (by positivity : (2 : ℝ)^k ≠ 0)).mp he
  have heq : (2 : ℝ)^k = (z : ℝ) * (l : ℝ) := by
    calc
      (2 : ℝ)^k = ((1 / (l : ℝ)) * (2 : ℝ)^k) * (l : ℝ) := by field_simp; ring
      _ = _ := by rw [h]
  have hz : 0 ≤ z := by
    by_contra! hneg
    have hneg' : (z : ℝ) < 0 := by exact_mod_cast hneg
    have := mul_neg_of_neg_of_pos hneg' hp
    have hpow : 0 < (2 : ℝ)^k := by positivity
    linarith
  have hi : (2 : ℤ)^k = z * (l : ℤ) := by exact_mod_cast heq
  have hn : (2 : ℕ)^k = z.toNat * l := by
    exact_mod_cast (show (2 : ℤ)^k = (z.toNat : ℤ) * (l : ℤ) by
      rw [Int.toNat_of_nonneg hz]; exact hi)
  have hdvd : l ∣ (2 : ℕ)^k := ⟨z.toNat, by simpa only [Nat.mul_comm] using hn⟩
  obtain ⟨e, _, he⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
  cases e with
  | zero => simp at he; omega
  | succ e =>
    rw [he, pow_succ, Nat.mul_mod] at hodd
    simp at hodd

/-- Case II: the actual zero-block and generalized common-mark
rigidity criteria prove disjointness for an odd integer ratio. -/
theorem hegyvari_disjoint_odd_ratio {a b : ℝ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    {l : ℕ} (hl : 3 ≤ l) (hodd : l % 2 = 1)
    (hba : b = (l : ℝ)*a) (hnd : ¬ Dyadic a) :
    SymbolicallyDisjoint a b := by
  have ha0 : 0 < a := by linarith
  have hb0 : 0 < b := by linarith
  have hl0 : (0 : ℝ) < (l : ℝ) := by exact_mod_cast (show 0 < l by omega)
  have hr : b/a = (l : ℝ) := by rw [hba]; field_simp
  have hr' : a/b = 1/(l : ℝ) := by rw [hba]; field_simp
  have hrecip : ¬ Dyadic (a/b) := by
    rw [hr']; exact hegyvari_reciprocal_nondyadic l hl hodd
  obtain ⟨j, hj, hbits⟩ := hegyvari_top_bits l hl
  apply HegyvariFloorDoubling.disjoint_of_oddMultiplier_criteria
    (f := HegyvariFloorDoubling.floorRay a) (g := HegyvariFloorDoubling.floorRay b)
    (u := HegyvariFloorDoubling.floorDigit a) (v := HegyvariFloorDoubling.floorDigit b)
    (l := l) hodd
    (HegyvariFloorDoubling.floorRay_binaryStep ha0.le)
    (HegyvariFloorDoubling.floorRay_binaryStep hb0.le)
  · intro n
    rw [hba]
    exact HegyvariFloorDoubling.floorRay_multiplier_bounds ha0.le l (by omega) n
  · exact hegyvari_unbounded ha0.le hnd
  · exact j+1
  · intro hnot
    exact hegyvari_transport hb0.le ha0.le
      (forwardTransport_of_not_symbolicallyDisjoint hb ha hrecip (fun h => hnot h.symm))
  · intro haligned
    obtain ⟨n, hn⟩ := HegyvariFloorDoubling.alignedZeroRuns_sequence haligned
    have htop : Tendsto n atTop atTop := tendsto_atTop.mpr
      (fun N => (eventually_ge_atTop N).mono (fun r hr => hr.trans (hn r).1))
    have hm : ∀ r, digit a (n r+j+1) = 1 := by
      intro r
      exact (hegyvari_digit_iff ha0.le _).mp (by
        simpa only [Nat.add_assoc] using (hn r).2.1)
    have hmarks := hegyvari_odd_common_marks ha hb hodd hj hr hbits n htop hm
    apply symbolicallyDisjoint_of_zero_blocks_and_rigidity_exclusion
      ha hb n id htop tendsto_id
    · intro r k hk
      have hzero := (hn r).2.2 k (by omega : k < r)
      rcases digit_zero_or_one b (n r+k) with hz | ho
      · exact hz
      · have htrue := (hegyvari_digit_iff hb0.le _).mpr ho
        rw [htrue] at hzero
        contradiction
    · intro μ hμ f hmean hreg
      by_contra hf
      exact tower_inverse_nonfixed_of_meanZero ha hμ f hf hmean
        (hμ.cross_common_mark_rigid_fixed ha hb n
          (fun r => n r - n r / 2 + j) htop hmarks f hreg)
  · intro h
    exact (symbolicallyDisjoint_of_boundedZeroRuns hb ha hrecip
      (hegyvari_bounded hb0.le h)).symm

