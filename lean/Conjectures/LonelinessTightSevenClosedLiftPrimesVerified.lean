    obtain ⟨i, hi⟩ := List.mem_ofFn.mp hrow'
    have hr : Loneliness.Modular.TightSevenPrime251.Binary.roots i = r := List.ofFn_injective hi
    have hrep' : Represents 251 (Loneliness.Modular.TightSevenPrime251.Binary.roots i) v := by
      simpa only [hr] using hrep
    exact Loneliness.Modular.TightSevenPrime251.Binary.classify_root_of_runner_bound
      hLRC i v hrep' hp hpositive hnodup hlow
