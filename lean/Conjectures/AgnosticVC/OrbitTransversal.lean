module

public import Mathlib.MeasureTheory.Integral.IntervalIntegral.Periodic

import Mathlib.Topology.Instances.AddCircle.DenseSubgroup

/-! No measurable choice of one representative in every coset of a countably infinite
subgroup exists under a translation-invariant probability law, even after completion. -/

@[expose] public section

open Function MeasureTheory Set
open scoped ENNReal

namespace AgnosticVC

variable {G : Type*} [AddCommGroup G] [MeasurableSpace G] [MeasurableEq G]

/-- The subgroup translates of the fixed points of a transversal partition the whole
space. Translation invariance gives each part the same measure, which is impossible
for a countably infinite partition of a probability space. -/
theorem no_measurable_orbitTransversal (Γ : AddSubgroup G) [Countable Γ] [Infinite Γ]
    (D : Measure G) [IsProbabilityMeasure D]
    (hpres : ∀ γ : Γ, MeasurePreserving (fun x : G => (γ : G) + x) D D)
    (r : NullMeasurableSpace G D → G) (horbit : ∀ x : G, x - r x ∈ Γ)
    (hinvar : ∀ (γ : Γ) (x : G), r ((γ : G) + x) = r x) : ¬ Measurable r := by
  intro hr
  let F : Set G := {x | r x = x}
  let T (γ : Γ) : Set G := (fun x : G => (γ : G) + x) ⁻¹' F
  let read : NullMeasurableSpace G D → G := fun x => x
  have hread : Measurable read := fun _ hs => hs.nullMeasurableSet
  have hF : NullMeasurableSet F D := measurableSet_eq_fun hr hread
  have hT (γ : Γ) : NullMeasurableSet (T γ) D :=
    hF.preimage (hpres γ).quasiMeasurePreserving
  have hmeasure (γ : Γ) : D (T γ) = D F := (hpres γ).measure_preimage hF
  have hdisjoint : Pairwise (Disjoint on T) := by
    intro a b hab
    refine Set.disjoint_left.mpr fun x ha hb => hab (Subtype.ext ?_)
    change r ((a : G) + x) = (a : G) + x at ha
    change r ((b : G) + x) = (b : G) + x at hb
    rw [hinvar] at ha hb
    exact add_right_cancel (ha.symm.trans hb)
  have hcover : (⋃ γ, T γ) = univ := by
    apply eq_univ_of_forall
    intro x
    let γ : Γ := ⟨r x - x, by rw [← neg_sub]; exact Γ.neg_mem (horbit x)⟩
    apply mem_iUnion.mpr
    refine ⟨γ, ?_⟩
    change r ((γ : G) + x) = (γ : G) + x
    rw [hinvar, show (γ : G) + x = r x from sub_add_cancel _ _]
  have hsum : (1 : ℝ≥0∞) = ∑' _ : Γ, D F := by
    rw [← tsum_congr hmeasure, ← measure_iUnion₀ (hdisjoint.mono fun _ _ h => h.aedisjoint) hT,
      hcover, measure_univ]
  by_cases hzero : D F = 0
  · simp [hzero] at hsum
  · rw [ENNReal.tsum_const_eq_top_of_ne_zero hzero] at hsum
    simp at hsum

/-- The countably infinite subgroup generated by the rotation through `√2` modulo one. -/
noncomputable def irrationalCircleSubgroup : AddSubgroup UnitAddCircle :=
  AddSubgroup.zmultiples ((Real.sqrt 2 : ℝ) : UnitAddCircle)

instance : Countable irrationalCircleSubgroup := by
  have h : (irrationalCircleSubgroup : Set UnitAddCircle).Countable := by
    rw [irrationalCircleSubgroup, AddSubgroup.coe_zmultiples]
    exact countable_range _
  exact h.to_subtype

instance : Infinite irrationalCircleSubgroup := by
  have hd : DenseRange (fun z : ℤ => z • ((Real.sqrt 2 : ℝ) : UnitAddCircle)) :=
    AddCircle.denseRange_zsmul_coe_iff.mpr (by simpa using irrational_sqrt_two)
  exact infinite_zmultiples.mpr (addOrderOf_eq_zero_iff.mp (AddCircle.denseRange_zsmul_iff.mp hd))

/-- No transversal for the irrational rotation is measurable for completed uniform
probability on the circle. -/
theorem no_measurable_circleOrbitTransversal
    (r : NullMeasurableSpace UnitAddCircle volume → UnitAddCircle)
    (horbit : ∀ x : UnitAddCircle, x - r x ∈ irrationalCircleSubgroup)
    (hinvar : ∀ (γ : irrationalCircleSubgroup) (x : UnitAddCircle),
      r ((γ : UnitAddCircle) + x) = r x) : ¬ Measurable r := by
  let _ : IsProbabilityMeasure (volume : Measure UnitAddCircle) := ⟨UnitAddCircle.measure_univ⟩
  exact no_measurable_orbitTransversal irrationalCircleSubgroup volume
    (fun γ => measurePreserving_add_left volume (γ : UnitAddCircle)) r horbit hinvar

end AgnosticVC
