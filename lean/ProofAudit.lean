  let allowed : Array Name := #[`propext, `Classical.choice, `Quot.sound]
  let prefixes := #["SolitaireCounterexample.", "SolitaireGeneral.", "War.", "Denominator.", "DenominatorDynamics.", "Egyptian.", "CutFamily.", "BinaryAutomata.", "CutPeriod.", "FiniteCertificate.", "PackingFourPoint.", "CutGeneral.", "Loneliness.", "NonmixedGap.", "SymmetricFourPoint.", "Haralambis.", "ThreeDistanceGraph.", "RectangleFinite.", "RectanglePartitions.", "RectangleEuler.", "LineSize."]
  let env ← getEnv
  let mut count : Nat := 0
  for (name, info) in env.constants.toList do
    let projectModule := match env.getModuleIdxFor? name |>.bind (env.header.modules[·]?) with
      | some mod =>
        let moduleName := mod.module.toString
        moduleName == "Solitaire" || moduleName.startsWith "Solitaire." ||
          moduleName == "Conjectures" || moduleName.startsWith "Conjectures."
      | none => false
    if projectModule || prefixes.any (fun p => (privateToUserName name).toString.startsWith p) then
      if let .axiomInfo _ := info then
        unless allowed.contains name do
          throwError "Unapproved project axiom {name}"
      if let .thmInfo _ := info then
        count := count + 1
        for axiomName in ← collectAxioms name do
          unless allowed.contains axiomName do
            throwError "Unapproved axiom {axiomName} in {name}"
  logInfo m!"PASS: {count} project theorems use only propext, Classical.choice, Quot.sound"
